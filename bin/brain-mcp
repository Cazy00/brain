#!/usr/bin/env python3
"""brain-mcp — minimal MCP stdio server exposing the second brain to any agent.

Zero dependencies and no vendor SDK: speaks newline-delimited JSON-RPC 2.0 over
stdio, so any MCP client that can spawn a process consumes it unmodified. It
shells out to bin/brain for the actual work, which is what makes retrieval
behavior identical on the CLI, over MCP, and across every client — the ranking
and the trust signals are deterministic code, not model judgement. Disposable by
design — if this dies, the brain degrades to grep over current files.

The tool table, the argument validator and the dispatcher moved to
brainlib/mcpcore.py when the HTTP transport arrived. This file is now only the
stdio framing. Two transports each carrying their own copy of the table would
drift, and a tool present over stdio and missing over HTTP is a bug nobody finds
until somebody far from their laptop needs it.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from brainlib import mcpcore

TRANSPORT = "local"
TOOLS = mcpcore.tools_for("capture", TRANSPORT)


def call_tool(name, args):
    return mcpcore.call(name, args, profile="capture", transport=TRANSPORT)


def reply(msg_id, result=None, error=None):
    out = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        out["error"] = error
    else:
        out["result"] = result
    sys.stdout.write(json.dumps(out) + "\n")
    sys.stdout.flush()


def dispatch(msg):
    method = msg.get("method", "")
    msg_id = msg.get("id")
    params = msg.get("params")
    if not isinstance(params, dict):
        params = {}
    if method == "initialize":
        reply(msg_id, {
            "protocolVersion": params.get("protocolVersion", "2025-06-18"),
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "brain", "version": "1.0.0"},
        })
    elif method == "tools/list":
        reply(msg_id, {"tools": TOOLS})
    elif method == "tools/call":
        args = params.get("arguments")
        reply(msg_id, call_tool(params.get("name", ""), args if args is not None else {}))
    elif method == "ping":
        reply(msg_id, {})
    elif msg_id is not None:
        reply(msg_id, error={"code": -32601, "message": f"method not found: {method}"})
    # notifications (no id) are ignored by design


MAX_LINE_CHARS = 10_000_000  # a single request larger than this is not real traffic


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line or len(line) > MAX_LINE_CHARS:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            # Deliberately broad: an unparseable line is skipped per JSON-RPC
            # (there is no id to answer). json.loads raises more than
            # JSONDecodeError — deeply nested input raises RecursionError,
            # which used to take the whole server down with it.
            continue
        if not isinstance(msg, dict):
            continue
        # Top-level containment: one malformed request must never take the
        # server down with it — every other session is sharing it.
        try:
            dispatch(msg)
        except Exception as exc:
            msg_id = msg.get("id")
            if msg_id is not None:
                reply(msg_id, error={"code": -32603, "message": f"internal error: {exc!r}"})


if __name__ == "__main__":
    main()
