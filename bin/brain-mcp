#!/usr/bin/env python3
"""brain-mcp — minimal MCP stdio server exposing the second brain to any agent.

Zero dependencies and no vendor SDK: speaks newline-delimited JSON-RPC 2.0 over
stdio, so any MCP client that can spawn a process consumes it unmodified.
Disposable by design — if this dies, the brain degrades to grep over current
files.

The tools themselves live in brainlib/mcp.py, because since 2026-07-29 there is
a second transport (`brain serve`, over HTTP) and both must expose exactly the
same brain. This file is the stdio half and nothing else; every client's
registration still names it, and its behaviour has not changed.
"""
import sys
from pathlib import Path

# bin/ on sys.path is what makes brainlib importable without a package install.
# Explicit rather than relying on sys.path[0], which belongs to whatever
# launched this — a client spawning it by absolute path, or a test.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from brainlib import mcp  # noqa: E402

if __name__ == "__main__":
    mcp.serve_stdio()
