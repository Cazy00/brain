    "windsurf": {
        "name": "Windsurf / Devin Desktop",
        "config": "~/.codeium/windsurf/mcp_config.json",
        "format": "json-mcpServers",
        "path": "~/.codeium/windsurf/mcp_config.json",
        "cli": None,
        "agents_md": "yes, workspace-scoped",
        "routing": "~/.codeium/windsurf/memories/global_rules.md  (6,000 char limit)",
        "routing_path": "~/.codeium/windsurf/memories/global_rules.md",
        "ignore": ".devinignore",
        "restart": "refresh from the Cascade MCP panel",
        "notes": ["Mid-rebrand: docs.windsurf.com now redirects to docs.devin.ai, but "
                  "~/.codeium/windsurf is still the live config folder. Create the "
                  "parent directories if they are missing.",
                  "No type/transport field. Remote servers use `serverUrl` in place of "
                  "`command`.",
                  "UNVERIFIED: no project-scoped mcp_config.json is documented, and "
                  "reload semantics after an edit are not doc-stated."],
    },
    "claude-desktop": {
        "name": "Claude Desktop",
        "config": "~/Library/Application Support/Claude/claude_desktop_config.json",
        "format": "json-mcpServers",
        # No Linux entry, and that is the answer rather than a gap: Claude
        # Desktop does not ship there. A made-up path would make detection
        # report a client that cannot be present.
        "path": {"macos": "~/Library/Application Support/Claude/"
                          "claude_desktop_config.json",
                 "linux": None,
                 "windows": "%APPDATA%/Claude/claude_desktop_config.json"},
        "cli": None,
        "agents_md": "no — Desktop reads no instruction file at all",
        "routing": "NO FILE — account Settings → Profile preferences, or rely on the "
                   "tool descriptions the server itself sends",
        "routing_path": None,
        "ignore": None,
        "restart": "quit with Cmd-Q and relaunch — closing the window is not enough",
        "notes": ["MERGE into the existing file. It may already hold preferences and "
                  "trusted-folder keys, and the official instruction to “replace the "
                  "contents” would destroy them. Back it up first.",
                  "`claude mcp add` targets Claude Code, not Desktop. Different config, "
                  "different app.",
                  "Desktop launches from the Dock and does not inherit your shell PATH: "
                  "the command must be an absolute path to an executable file."],
    },
}

CONNECT_FORMATS = {
    "toml": '[mcp_servers.brain]\ncommand = "{server}"\nargs = []',
    "json-mcpServers": ('{{\n  "mcpServers": {{\n    "brain": {{\n'
                        '      "command": "{server}",\n      "args": []\n'
                        '    }}\n  }}\n}}'),
    "json-mcpServers-typed": ('{{\n  "mcpServers": {{\n    "brain": {{\n'
                              '      "type": "stdio",\n      "command": "{server}",\n'
                              '      "args": []\n    }}\n  }}\n}}'),
    "json-servers": ('{{\n  "servers": {{\n    "brain": {{\n'
                     '      "type": "stdio",\n      "command": "{server}",\n'
                     '      "args": []\n    }}\n  }}\n}}'),
}


# What `--apply` writes, per format: the container key and any fields beyond
# command/args. Kept beside CONNECT_FORMATS rather than parsed back out of it —
# those strings exist for a human to paste, and a machine reading its own output
# is one refactor away from writing something nobody was ever shown. The two
# are held in step by a test that renders both and compares them.
CONNECT_TARGETS = {
    "toml": ("toml", "mcp_servers.brain", {}),
    "json-mcpServers": ("json", "mcpServers", {}),
    "json-mcpServers-typed": ("json", "mcpServers", {"type": "stdio"}),
    "json-servers": ("json", "servers", {"type": "stdio"}),
}


def expand_client_path(spec):
    """Resolve a CONNECT_CLIENTS path spec to a real path on THIS machine.

    Returns None when there is nothing to resolve — either the client owns no
    writable file (Claude Code, whose two files `init` writes), or it does not
    exist on this OS at all (Claude Desktop on Linux). None is an answer here,
    not a failure: detection must not report a client that cannot be present,
    and `--apply` must not create a file nothing will ever read.

    Every spec is anchored to a home directory rather than being absolute, so
    that the tests can redirect HOME and so that `--apply` run from inside the
    brain cannot write another tool's config into the brain.
    """
    import os

    if isinstance(spec, dict):
        spec = spec.get(osbackend.os_family())
    if not spec:
        return None
    if spec.startswith("~/"):
        return Path.home() / spec[2:]
    if spec.startswith("%APPDATA%/"):
        # Only set on Windows. Nothing else can honour this spelling, and
        # guessing an equivalent would put a file where nothing looks for it.
        base = os.environ.get("APPDATA")
        return Path(base) / spec[len("%APPDATA%/"):] if base else None
    return Path(spec)


def routing_block() -> str:
    """The two paragraphs that make an agent reach for the brain unprompted.

    One source, rendered per client. Both halves are load-bearing: the first
    makes it RETRIEVE, the second makes it OFFER TO CAPTURE. Ship only the
    first and you get a brain that answers but never grows.
    """
    path = ROOT / "setup" / "templates" / "routing-block.md"
    if not path.exists():
        return f"(missing {path.relative_to(ROOT)})"
    return path.read_text(encoding="utf-8").replace("{{REPO}}", str(ROOT)).rstrip()


def print_client(key: str) -> None:
    client = CONNECT_CLIENTS[key]
    server = str(ROOT / "bin" / "brain-mcp")
    print(f"\n=== {client['name']}  ({key}) " + "=" * max(0, 46 - len(client['name'])))
    print(f"\n1. Register the server        {client['config']}")
    if client["format"]:
        print()
        for line in CONNECT_FORMATS[client["format"]].format(server=server).splitlines():
            print(f"     {line}")
    if client["cli"]:
        print(f"\n   or, equivalently:\n     {client['cli'].format(server=server)}")
    print(f"\n2. Global routing rule        {client['routing']}")
    print("   (print the block itself with: bin/brain connect --routing)")
    print(f"\n3. Restart                    {client['restart']}")
    print(f"\n   AGENTS.md support          {client['agents_md']}")
    if client["ignore"]:
        print(f"   Ignore file                {client['ignore']} — written by "
              "`bin/brain connect --write-ignores`")
    if client["notes"]:
        print("\n   Watch out:")
        for note in client["notes"]:
            wrapped = textwrap.wrap(note, 68)
            print(f"     - {wrapped[0]}")
            for line in wrapped[1:]:
                print(f"       {line}")


def client_paths(key: str) -> tuple:
    """(config path, routing path) for this machine. Either may be None."""
    client = CONNECT_CLIENTS[key]
    return (expand_client_path(client.get("path")),
            expand_client_path(client.get("routing_path")))


def client_installed(key: str) -> bool:
    """Is this client on this machine at all?

    The test is whether the DIRECTORY its config lives in exists, not the
    config file. A client that has never had an MCP server registered has no
    mcp.json and is still installed — the directory is what it creates on first
    run, and the file is what we are here to write.
    """
    for path in client_paths(key):
        if path is not None and path.parent.is_dir():
            return True
    return False


def server_entry(fmt: str) -> tuple:
    """(kind, container, entry) — the brain server in one client's spelling."""
    kind, container, extra = CONNECT_TARGETS[fmt]
    entry = dict(extra)
    entry["command"] = str(ROOT / "bin" / "brain-mcp")
    entry["args"] = []
    return kind, container, entry


def apply_client(key: str, dry_run: bool = False):
    """Register the brain server with one client. Returns a configedit.Outcome."""
    from brainlib import configedit

    client = CONNECT_CLIENTS[key]
    if key == "claude-code":
        # Claude Code's two files are this repo's own, and `init` already
        # writes them — including the parts no config merge could do, like
        # rendering the skill and registering at user scope. Duplicating that
        # here would give the same job two implementations that drift.
        if dry_run:
            return configedit.Outcome(
                "updated", "would run the `brain init` wiring: git hooks, .mcp.json, "
                "the /brain skill, and `claude mcp add --scope user`")
        return configedit.Outcome(
            "updated" if cmd_init([]) == 0 else "refused",
            "wired this clone into Claude Code",
            snippet="python3 bin/brain init")

    target, _ = client_paths(key)
    if target is None:
        return configedit.Outcome(
            "refused",
            f"{client['name']} has no config file this can write on "
            f"{osbackend.os_family()} — see the notes in `brain connect {key}`",
            snippet=f"# nothing to write on this OS\n# {client['config']}")

    kind, container, entry = server_entry(client["format"])
    if kind == "toml":
        return configedit.apply_toml(target, container, entry, dry_run=dry_run)
    return configedit.apply_json(target, container, "brain", entry, dry_run=dry_run)


def print_outcome(key: str, outcome, dry_run: bool) -> None:
    """One client's result, plus the diff when nothing was written."""
    import difflib

    print(f"  [{outcome.action}] {outcome.detail}")
    if outcome.backup:
        print(f"            backup: {outcome.backup}")
    if outcome.action == "refused":
        print("\n  Paste this yourself instead — which is what this command did for "
              "every\n  client before --apply existed, and it still works:\n")
        for line in outcome.snippet.splitlines():
            print(f"     {line}")
    if dry_run and outcome.preview:
        target, _ = client_paths(key)
        before = read_text(target).splitlines(keepends=True) if target and target.exists() else []
        diff = difflib.unified_diff(before, outcome.preview.splitlines(keepends=True),
                                    fromfile=str(target), tofile=str(target) + " (proposed)")
        print()
        for line in diff:
            print("  " + line.rstrip("\n"))


def client_wiring(key: str) -> tuple:
    """(state, detail) — what this client is pointed at right now.

    States: 'this' (this brain), 'other' (a DIFFERENT brain — the case that
    silently breaks things), 'no' (nothing registered), 'unknown' (a config
    that exists and cannot be read).

    'unknown' is not folded into 'no' on purpose. JSONC parses for the client
    and not for us, and reporting a working registration as absent would send
    somebody to fix wiring that is already correct.
    """
    server = str(ROOT / "bin" / "brain-mcp")
    if key == "claude-code":
        # No config file of its own to read — `init` writes .mcp.json inside
        # whichever clone it ran from, so the machine-wide question is which
        # clone the global skill link points into.
        link = Path.home() / ".claude" / "skills" / "brain"
        if not link.exists() and not link.is_symlink():
            return "no", ""
        try:
            target = link.resolve()
        except OSError:
            return "unknown", str(link)
        here = ROOT.resolve()
        if target == here or here in target.parents:
            return "this", ""
        return "other", str(target)

    target, _ = client_paths(key)
    if target is None or not target.is_file():
        return "no", ""
    client = CONNECT_CLIENTS[key]
    _, container, _ = CONNECT_TARGETS[client["format"]]
    text = read_text(target)
    if client["format"] == "toml":
        # Same text-only reasoning as configedit: no parser below 3.11.
        in_table, command = False, ""
        for line in text.splitlines():
            if line.strip() == f"[{container}]":
                in_table = True
                continue
            if in_table and line.lstrip().startswith("["):
                break
            if in_table and line.strip().startswith("command"):
                _, _, value = line.partition("=")
                command = value.strip().strip('"').strip("'")
        if not command:
            return "no", ""
        return ("this", "") if command == server else ("other", command)

    import json as _json
    try:
        parsed = _json.loads(text) if text.strip() else {}
    except ValueError:
        return "unknown", str(target)
    entry = (parsed.get(container) or {}).get("brain") if isinstance(parsed, dict) else None
    if not isinstance(entry, dict):
        return "no", ""
    command = entry.get("command", "")
    return ("this", "") if command == server else ("other", command)


def routing_applied(key: str) -> bool:
    """Is this brain's routing block in that client's instruction file?

    Both halves are required. A marked block naming a DIFFERENT brain is not
    this brain's routing rule, and calling it applied would hide exactly the
    same failure client_wiring exists to surface.
    """
    from brainlib import configedit

    _, routing = client_paths(key)
    if routing is None or not routing.is_file():
        return False
    text = read_text(routing)
    return configedit.MARKER_START in text and str(ROOT) in text


def connect_report(as_json: bool = False) -> int:
    """What THIS machine is wired to, rather than a catalogue of what exists."""
    server = str(ROOT / "bin" / "brain-mcp")
    rows = []
    for key, client in CONNECT_CLIENTS.items():
        config, routing = client_paths(key)
        state, detail = client_wiring(key)
        rows.append((key, client, client_installed(key), state, detail,
                     config, routing, routing_applied(key)))

    if as_json:
        import json as _json
        print(_json.dumps({
            "server": server,
            "clients": {key: {
                "name": client["name"],
                "installed": installed,
                "wired": state,
                "wired_to": detail,
                "path": str(config) if config else None,
                "routing_path": str(routing) if routing else None,
                "routing_applied": applied,
            } for key, client, installed, state, detail, config, routing, applied in rows},
        }, indent=2))
        return 0

    print("Every client below runs the SAME stdio server, unmodified:")
    print(f"  {server}\n")
    print("On this machine:\n")
    for key, client, installed, state, detail, _config, routing, applied in rows:
        if not installed:
            status = "not installed"
        elif state == "other":
            status = f"WIRED TO A DIFFERENT brain — {detail}"
        elif state == "unknown":
            status = f"could not read {detail} — check it yourself"
        elif state == "this":
            status = "wired to this brain"
            if routing is None:
                # Not a gap. Cursor and Claude Desktop have no instruction file,
                # so "no routing block" would read as something left undone.
                status += " (routing rule is a UI setting)"
            else:
                status += ", routing block in place" if applied else ", no routing block"
        else:
            status = "not wired"
        print(f"  {key:<16} {client['name']:<26} {status}")
    print("\n  brain connect <client>            what to paste, and what silently breaks")
    print("  brain connect --all --apply       write it for every client found here")
    print("  brain connect --routing --apply   add the block that makes agents reach "
          "for it")
    return 0


def apply_routing(keys: list, dry_run: bool = False) -> int:
    """Write the routing block into each client's global instruction file.

    With no client named this sweeps every client that is actually installed,
    for the same reason `--all --apply` does: a routing file created for a
    client nobody has is an instruction nothing will ever read, sitting in a
    directory this command invented.
    """
    from brainlib import configedit

    unknown = [k for k in keys if k not in CONNECT_CLIENTS]
    if unknown:
        print(f"unknown client(s): {', '.join(unknown)}")
        print(f"known: {', '.join(CONNECT_CLIENTS)}")
        return 2
    targets = keys or [k for k in CONNECT_CLIENTS if client_installed(k)]
    if not targets:
        print("No supported client found on this machine. `brain connect --routing` "
              "prints the\nblock; name a client explicitly to write it anyway.")
        return 0

    block = routing_block()
    refused = 0
    for key in targets:
        client = CONNECT_CLIENTS[key]
        print(f"\n=== {client['name']}  ({key}) "
              + "=" * max(0, 46 - len(client['name'])))
        _, routing = client_paths(key)
        if routing is None:
            # Not a failure. Cursor and Claude Desktop keep this rule in a
            # settings UI, and an exit code that went red on the normal case
            # would stop meaning anything.
            print(f"  [skipped ] no instruction file — {client['routing']}")
            continue
        outcome = configedit.apply_markers(routing, block,
                                           preamble=client.get("routing_preamble", ""),
                                           dry_run=dry_run)
        print(f"  [{outcome.action}] {outcome.detail}")
        if outcome.backup:
            print(f"            backup: {outcome.backup}")
        if outcome.action == "refused":
            refused += 1
            print("\n  Paste this yourself instead:\n")
            for line in outcome.snippet.splitlines():
                print(f"     {line}")
    print("\nRestart the client — global instructions are read at session start.")
    return 1 if refused else 0


# Folders no client's own index should be walking. archive/ is superseded and
# would be read back as current; inbox/ and journal/ are provisional and have
# not been through consolidation; vault/ is encrypted and its plaintext must
# never be reconstructed from an index.
#
# These are a BACKSTOP, not the control. Cursor's docs say it plainly: terminal
# and MCP tools "cannot block access to code governed by .cursorignore". The
# rule that actually holds is the one in AGENTS.md — retrieve through the tools,
# which apply currency and print the trust signals — and the containment inside
# bin/brain itself. An ignore file narrows the blast radius of a client that
# indexes anyway; it does not make the rule unnecessary.
IGNORE_SCOPE = ("knowledge/archive/", "knowledge/vault/", "knowledge/inbox/",
                "knowledge/journal/", ".cache/")
IGNORE_FILES = {
    ".geminiignore": "Gemini CLI",
    ".cursorignore": "Cursor",
    ".devinignore": "Windsurf / Devin Desktop",
}


def write_ignore_files() -> list:
    """Emit one ignore file per client that honours one. Returns what changed."""
    written = []
    for name, client in sorted(IGNORE_FILES.items()):
        body = (
            f"# {name} — keeps {client}'s own file index out of the parts of this\n"
            "# brain that are not current knowledge. A BACKSTOP, not the control:\n"
            "# these files do not stop an agent's terminal or MCP tools from reading\n"
            "# the same paths. The rule that holds is in AGENTS.md — retrieve through\n"
            "# bin/brain search or the MCP tools, which resolve currency and print the\n"
            "# trust signals a raw file read has no way to carry.\n"
            "#\n"
            "# Generated by `bin/brain connect --write-ignores`.\n\n"
            + "".join(f"{path}\n" for path in IGNORE_SCOPE))
        path = ROOT / name
        if not path.exists() or path.read_text(encoding="utf-8") != body:
            path.write_text(body, encoding="utf-8")
            written.append(name)
    return written


def cmd_connect(argv: list) -> int:
    """Wire this brain into any MCP-capable agent.

    The server is vendor-neutral by construction — zero dependencies, plain
    JSON-RPC over stdio, no vendor SDK — so every client below consumes the
    SAME server unmodified. What this command supplies is the per-client
    spelling, which is where the real failures are: a wrong top-level key
    produces a server that never appears and never explains why.
    """
    apply_it = "--apply" in argv
    dry_run = "--dry-run" in argv
    if dry_run and not apply_it:
        # Without --apply this command already only prints, so a --dry-run that
        # quietly did the same thing would read back as confirmation that a
        # write had been asked for and previewed.
        print("--dry-run only means something with --apply — without it, connect "
              "already only prints.")
        return 2

    if "--routing" in argv:
        from brainlib import configedit
        if not apply_it:
            # Printed WITH the markers: somebody who pastes by hand must end up
            # with the same thing --apply writes, or `brain retire` can undo one
            # and not the other.
            print(f"{configedit.MARKER_START}\n{routing_block()}\n"
                  f"{configedit.MARKER_END}")
            return 0
        return apply_routing([a for a in argv if not a.startswith("--")], dry_run)
    if "--write-ignores" in argv:
        written = write_ignore_files()
        print("wrote: " + ", ".join(written) if written else
              "ignore files already up to date")
        print("These narrow what a client's own index sees. They are not a read "
              "barrier — see AGENTS.md 'Searching'.")
        return 0
    args = [a for a in argv if not a.startswith("--")]
    if "--all" in argv:
        # A sweep writes only to clients that are actually here. Creating
        # ~/.codex/config.toml on a machine with no Codex is litter, and worse
        # than litter: the next run detects the client as present because of
        # the directory this one made. Naming a client explicitly is different
        # — that is a person saying they want it.
        args = [k for k in CONNECT_CLIENTS if not apply_it or client_installed(k)]
        if apply_it and not args:
            print("No supported client found on this machine. `brain connect` lists "
                  "what is\nsupported; name one explicitly to wire it anyway.")
            return 0
    if apply_it and args:
        unknown = [a for a in args if a not in CONNECT_CLIENTS]
        if unknown:
            print(f"unknown client(s): {', '.join(unknown)}")
            print(f"known: {', '.join(CONNECT_CLIENTS)}")
            return 2
        refused = 0
        for key in args:
            # Header first, then the work. claude-code's branch runs the init
            # wiring, which prints five lines of its own — under a header
            # printed afterwards they would look like the previous client's.
            client = CONNECT_CLIENTS[key]
            print(f"\n=== {client['name']}  ({key}) "
                  + "=" * max(0, 46 - len(client['name'])))
            outcome = apply_client(key, dry_run=dry_run)
            print_outcome(key, outcome, dry_run)
            refused += outcome.action == "refused"
        print("\nFull manual instructions for any client: brain connect <client>")
        print("Then verify from that client: ask it to search your brain for a term "
              "you know\nis in a note. Tools appearing in a list is not the same as "
              "the server working.")
        # Non-zero on a refusal so a scripted run cannot read it as a write.
        return 1 if refused else 0
    if not args:
        return connect_report(as_json="--json" in argv)
    unknown = [a for a in args if a not in CONNECT_CLIENTS]
    if unknown:
        print(f"unknown client(s): {', '.join(unknown)}")
        print(f"known: {', '.join(CONNECT_CLIENTS)}")
        return 2
    for key in args:
        print_client(key)
    print("\nThen verify from that client: ask it to search your brain for a term "
          "you know\nis in a note. Tools appearing in a list is not the same as the "
          "server working.")
    return 0


def cmd_new(argv: list) -> int:
    if not argv:
        print("usage: brain new <decision|reference|topic|person|project|note> \"<title>\" "
              "[--topics a,b] [--sensitivity normal|personal]")
        return 2
    kind = argv[0]
    title = argv[1] if len(argv) > 1 else None
    if kind == "journal":
        today = date.today().isoformat()
        path = K / "journal" / today[:4] / f"{today}.md"
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            path.write_text(f"# {today}\n\n", encoding="utf-8")
        print(path)
        return 0
    if kind not in FOLDER_KIND.values():
        print(f"unknown kind {kind!r} — one of: {', '.join(sorted(set(FOLDER_KIND.values())))}, journal")
        return 2
    if not title:
        print("a title is required")
        return 2

    topics_arg = ""
    # Key the default off the DESTINATION FOLDER, not the kind. FOLDER_KIND maps
    # life -> note, so keying off kind gave knowledge/life/ — a folder the protocol
    # names as requiring classification — the least protective default, silently
    # and while linting clean.
    target_folder = {v: k for k, v in FOLDER_KIND.items()}.get(kind)
    sensitivity = "personal" if target_folder in SENSITIVITY_REQUIRED else "normal"
    for i, arg in enumerate(argv):
        if arg == "--topics" and i + 1 < len(argv):
            topics_arg = argv[i + 1]
        if arg == "--sensitivity" and i + 1 < len(argv):
            sensitivity = argv[i + 1]

    vocabulary = load_topics()
    chosen = [t.strip() for t in topics_arg.split(",") if t.strip()]
    if not chosen:
        print("--topics is required (correct-by-construction: lint rejects notes without "
              "topics). Known topics: " + (", ".join(sorted(vocabulary)) or "(none)"))
        return 2
    for t in chosen:
        if t not in vocabulary:
            print(f"topic {t!r} is not in knowledge/topics.yaml — add it there first. "
                  "Known topics: " + (", ".join(sorted(vocabulary)) or "(none)"))
            return 1

    today = date.today().isoformat()
    slug = slugify(title)
    folder = {v: k for k, v in FOLDER_KIND.items()}[kind]
    if kind == "decision":
        note_id = unique_id(f"{today}-{slug}")
        path = K / folder / f"{note_id}.md"
    elif kind == "project":
        note_id = unique_id(f"project-{slug}")
        path = K / folder / note_id.removeprefix("project-") / "overview.md"
    else:
        note_id = unique_id(slug)
        path = K / folder / f"{note_id}.md"
    if path.exists():
        print(f"a note with this slug already exists: {path} — edit it, or choose a "
              "different title")
        return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        render_template(kind, {
            "ID": note_id,
            "TITLE": title,
            "DATE": today,
            "TOPICS": ", ".join(chosen),
            "SENSITIVITY": sensitivity,
        }),
        encoding="utf-8",
    )
    print(path)
    print("now: fill the body, add 2-5 aliases, then run 'bin/brain lint'")
    return 0


def cmd_capture(argv: list) -> int:
    do_commit = "--commit" in argv
    text = " ".join(a for a in argv if a != "--commit").strip()
    if not text:
        print("usage: brain capture \"<text>\" [--commit]")
        return 2
    today = date.today().isoformat()
    stamp = time.strftime("%H%M%S")
    slug = slugify(text)[:40]
    path = K / "inbox" / f"{today}-{stamp}-{slug}.md"
    n = 2
    while path.exists():
        path = K / "inbox" / f"{today}-{stamp}-{slug}-{n}.md"
        n += 1
    body = f"---\ncreated: {today}\nstatus: draft\n---\n\n{text}\n"
    # Scan BEFORE the write, not after. Without this the only moment an inbox
    # note ever meets scan_secrets is --commit -> pre-commit -> lint --staged,
    # so a capture without --commit (the CLI default) reached disk unexamined
    # and stayed there, searchable under --scope all. Refusing here costs the
    # note, which is correct: the text is still in the caller's hands, and a
    # credential that never touches the working tree can never be committed.
    problems = []
    scan_secrets(path, problems, raw=body.encode("utf-8"))
    if problems:
        print("REFUSED — the text looks like it contains a credential:")
        for _p, msg in problems:
            print(f"  - {msg}")
        print("Nothing was written. Put the value in Keychain and capture a note that "
              "names it instead (see .env.example).")
        return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body, encoding="utf-8")
    print(path)
    if do_commit:
        # --commit was ASKED for, so failing to commit is a failure: the note
        # exists only on this machine, unvetted and unbacked. Returning 0 here
        # made the MCP layer report isError:false and every caller believe the
        # note was safely in git.
        # Commit ONLY this note's path (git commit -- <path>), under a lock:
        #  - the pathspec keeps unrelated staged work-in-progress out of the
        #    capture commit, and
        #  - the lock removes the concurrent-capture index race.
        # The branch test lives INSIDE the lock with the commit it guards.
        # Read outside it, it was a TOCTOU: consolidate could cut its branch in
        # the gap, and the capture would commit onto it anyway — the exact
        # outcome this test exists to prevent. consolidate takes the same lock
        # around its own branch switches, so the two can no longer interleave.
        with repo_lock():
            branch = git("rev-parse", "--abbrev-ref", "HEAD")
            if branch.startswith("consolidate/"):
                # A capture committed onto the consolidation branch gets carried
                # off to a review branch and vanishes from main's working tree.
                # Write to disk (never lost), skip the commit, tell the truth.
                print(f"SAVED BUT NOT COMMITTED: currently on branch {branch!r} "
                      "(a consolidation pass is running). The note is on disk at the path "
                      "above and is NOT lost — commit it from main once consolidation lands.")
                return 1
            add = subprocess.run(["git", "add", str(path)], cwd=ROOT,
                                 capture_output=True, text=True)
            commit = subprocess.run(
                ["git", "commit", "-m", f"capture: {slug}", "--", str(path)],
                cwd=ROOT, capture_output=True, text=True,
            )
        if add.returncode != 0 or commit.returncode != 0:
            detail = (commit.stderr.strip() or commit.stdout.strip()
                      or add.stderr.strip() or "git failed")
            print(f"SAVED BUT NOT COMMITTED: {detail}")
            print("The note is on disk at the path above and is NOT lost — do not "
                  "capture it again. Commit it once the problem is fixed.")
            return 1
        print("captured and committed — push runs in background "
              "(bin/brain doctor verifies backup)")
    return 0


INDEX_DB = ROOT / ".cache" / "index.db"
FOLDER_WEIGHTS = {"decisions": 1.2, "reference": 1.2, "topics": 1.0, "projects": 1.0,
                  "people": 1.0, "life": 1.0, "journal": 0.6, "inbox": 0.6}


WIKILINK_RE = re.compile(r"\[\[\s*([^\]\[|#\n]+?)\s*(?:[|#][^\]\n]*)?\]\]")


def extract_links(body: str) -> list:
    """Wikilink targets in a note body, in order, de-duplicated.

    Accepts [[note-id]], [[note-id|display text]] and [[note-id#section]] —
    the target is everything before the first | or #."""
    seen, out = set(), []
    for m in WIKILINK_RE.finditer(body or ""):
        target = m.group(1).strip()
        if target and target not in seen:
            seen.add(target)
            out.append(target)
    return out


def indexable_paths():
    """Every note the search index should contain — canonical + journal +
    inbox, never archive/vault/attachments. Single definition so the index and
    its freshness check can never disagree about what belongs in it."""
    for path in sorted(K.rglob("*.md")):
        rel = path.relative_to(K)
        if rel.parts[0] in ("archive", "vault", "attachments") or path.name in EXEMPT_NAMES:
            continue
        yield path


def all_note_paths():
    """Every note with frontmatter, INCLUDING archive/ — the id->path universe.

    Wider than indexable_paths() on purpose: search must not return superseded
    notes, but id resolution must still find them, because that is exactly how
    `brain read <old-id>` follows a supersede chain to the current version."""
    for path in sorted(K.rglob("*.md")):
        rel = path.relative_to(K)
        if rel.parts[0] in ("vault", "attachments"):
            continue
        yield path


def note_records():
    """Indexable records for searchable notes (canonical + journal + inbox; never archive/vault)."""
    for path in indexable_paths():
        top = path.relative_to(K).parts[0]
        text = read_text(path)
        fm, _err = parse_frontmatter(text)
        body = text
        if fm:
            body = "\n".join(text.splitlines()[fm.get("_end_line", 0):])
        aliases = (fm or {}).get("aliases") or []
        topics_list = (fm or {}).get("topics") or []
        yield {
            "id": (fm or {}).get("id") or f"{top}-{path.stem}",
            "path": str(path.relative_to(ROOT)),
            "title": str((fm or {}).get("title") or path.stem),
            "folder": top,
            "kind": str((fm or {}).get("kind") or top),
            "created": str((fm or {}).get("created") or ""),
            "aliases": ", ".join(aliases if isinstance(aliases, list) else [str(aliases)]),
            "topics": ", ".join(topics_list if isinstance(topics_list, list) else [str(topics_list)]),
            "body": body,
            "links": extract_links(body),
        }


def cmd_index(quiet: bool = False, skip_if_fresh: bool = False) -> int:
    """Rebuild the FTS index atomically, one builder at a time.

    Every agent session runs its own MCP server, and each one rebuilds on its
    first stale search — so N of them start at the same instant. They used to
    share ONE temp path and destroy each other's half-built database ("table
    fts already exists", "disk I/O error"). Now: an advisory lock elects a
    single builder, the loser finds the index already fresh, and the build goes
    to a private temp file swapped in by atomic rename.
    """
    import os
    import sqlite3
    try:
        import fcntl
    except ImportError:  # non-POSIX: unique temp + atomic rename still hold
        fcntl = None

    INDEX_DB.parent.mkdir(exist_ok=True)
    lock_file = open(INDEX_DB.with_name("index.lock"), "w")
    try:
        if fcntl is not None:
            fcntl.flock(lock_file, fcntl.LOCK_EX)
        if skip_if_fresh and not index_stale():
            return 0                      # another process just built it
        tmp = INDEX_DB.with_name(f"index.db.{os.getpid()}.tmp")
        try:
            db = sqlite3.connect(tmp)
            db.execute(
                "CREATE VIRTUAL TABLE fts USING fts5(title, aliases, topics, body, "
                "id UNINDEXED, path UNINDEXED, folder UNINDEXED, kind UNINDEXED, "
                "created UNINDEXED, tokenize='porter unicode61 remove_diacritics 2')"
            )
            # The [[wikilink]] graph, derived in this same pass — note_records()
            # already reads every body, so backlinks cost no extra scan. Like
            # the FTS table this is disposable: rebuilt from the notes, never
            # authoritative.
            db.execute("CREATE TABLE links (src TEXT NOT NULL, dst TEXT NOT NULL)")
            # id -> path/frontmatter for EVERY note including archive/. Without
            # it, resolving one id meant re-reading and re-parsing the whole
            # corpus (collect_notes), which put `brain read` — the primary
            # retrieval verb — on an O(total notes) path. The whole frontmatter
            # is stored verbatim as JSON so consumers get byte-identical
            # semantics to a live parse, not a lossy projection of it.
            db.execute("CREATE TABLE notes_meta (id TEXT, rel TEXT, status TEXT, "
                       "superseded_by TEXT, supersedes TEXT, review_by TEXT, fm_json TEXT)")
            db.execute("CREATE INDEX notes_meta_id ON notes_meta (id)")
            db.execute("CREATE INDEX notes_meta_rel ON notes_meta (rel)")
            # Lets the commit gate ask "does anything else already supersede X?"
            # without walking every note.
            db.execute("CREATE INDEX notes_meta_supersedes ON notes_meta (supersedes)")
            meta_count = 0
            for path in all_note_paths():
                fm, _err = parse_frontmatter(read_text(path))
                if not fm or not isinstance(fm.get("id"), str) or not fm["id"]:
                    continue
                def _flat(key):
                    v = fm.get(key)
                    return v if isinstance(v, str) else None
                db.execute("INSERT INTO notes_meta (id, rel, status, superseded_by, "
                           "supersedes, review_by, fm_json) VALUES (?,?,?,?,?,?,?)",
                           (fm["id"], str(path.relative_to(K)), _flat("status"),
                            _flat("superseded_by"), _flat("supersedes"),
                            _flat("review_by"), _json_dumps(fm)))
                meta_count += 1
            count = 0
            for r in note_records():
                db.execute(
                    "INSERT INTO fts (title, aliases, topics, body, id, path, folder, "
                    "kind, created) VALUES (?,?,?,?,?,?,?,?,?)",
                    (r["title"], r["aliases"], r["topics"], r["body"], r["id"], r["path"],
                     r["folder"], r["kind"], r["created"]),
                )
                for dst in r["links"]:
                    db.execute("INSERT INTO links (src, dst) VALUES (?,?)", (r["id"], dst))
                count += 1
            db.execute("CREATE INDEX links_dst ON links (dst)")
            db.execute("CREATE INDEX links_src ON links (src)")
            db.commit()
            db.close()
            os.replace(tmp, INDEX_DB)
        finally:
            if tmp.exists():
                tmp.unlink()
    finally:
        lock_file.close()
    if not quiet:
        print(f"brain index: {count} notes indexed -> .cache/index.db")
    return 0


def _json_dumps(obj) -> str:
    import json as _json
    return _json.dumps(obj)


def index_uri() -> str:
    """Read-only URI for the index. as_uri() percent-encodes, so a repo path
    containing spaces or unicode still produces a valid URI."""
    return INDEX_DB.as_uri() + "?mode=ro"


def indexed_count() -> int:
    """Rows currently in the index, or -1 if it cannot be read (forces rebuild)."""
    return indexed_counts()[0]


def indexed_counts() -> tuple:
    """(fts rows, notes_meta rows). -1 for either if it cannot be read, which
    forces a rebuild rather than trusting a database we could not inspect."""
    import sqlite3
    try:
        db = sqlite3.connect(index_uri(), uri=True)
        try:
            fts = db.execute("SELECT COUNT(*) FROM fts").fetchone()[0]
            try:
                meta = db.execute("SELECT COUNT(*) FROM notes_meta").fetchone()[0]
            except sqlite3.OperationalError:
                meta = -1          # index predates notes_meta
            return fts, meta
        finally:
            db.close()
    except Exception:
        return -1, -1


def index_stale() -> bool:
    """Is the derived cache behind the notes?

    Runs before every search and every id lookup, so it walks with os.scandir
    and plain strings: building a Path per note (and sorting them) cost more
    than everything it was guarding. Deliberately checks the WIDER set — the db
    also holds notes_meta over archive/, so archiving a note must invalidate,
    or id resolution keeps serving a path that has since moved.
    """
    import os
    if not INDEX_DB.exists():
        return True
    built = INDEX_DB.stat().st_mtime
    kroot = str(K)
    live = indexable = 0
    stack = [(kroot, None)]
    while stack:
        directory, top = stack.pop()
        try:
            entries = os.scandir(directory)
        except OSError:
            continue
        with entries:
            for entry in entries:
                name = entry.name
                try:
                    if entry.is_dir(follow_symlinks=False):
                        if top is None and name in ("vault", "attachments"):
                            continue
                        stack.append((entry.path, name if top is None else top))
                        continue
                    if not name.lower().endswith(".md"):
                        continue
                    stat = entry.stat()
                except OSError:
                    continue
                live += 1
                if top != "archive" and name not in EXEMPT_NAMES:
                    indexable += 1
                if stat.st_mtime > built:
                    return True
    # Deleting a note changes no surviving file's mtime, so mtime alone cannot
    # see it — without this a deleted note keeps answering searches, pointing
    # at a file that is gone.
    fts_rows, meta_rows = indexed_counts()
    if indexable != fts_rows:
        return True
    # notes_meta only holds notes that HAVE an id, so it is a subset of `live`;
    # more rows than files on disk means notes were removed.
    return meta_rows > live


BM25_WEIGHTS = "8.0, 6.0, 4.0, 1.0, 0, 0, 0, 0, 0"  # title, aliases, topics, body, then UNINDEXED


def do_search(query: str, scope: str = "canonical", limit: int = 8) -> dict:
    """Rank inside SQLite, THEN limit.

    This used to `LIMIT 100` with no ORDER BY and sort those rows in Python.
    FTS5 returns matches in an arbitrary order without ORDER BY, so once more
    than 100 notes matched, the best hit could be discarded before ranking ever
    ran. Folder authority is folded into the SQL ordering expression so the
    ranking that decides the cut is the same one that orders the output.
    """
    import sqlite3
    if index_stale():
        cmd_index(quiet=True, skip_if_fresh=True)
    if not INDEX_DB.exists():          # index could not be built (read-only disk?)
        return {"mode": "none", "hits": [], "more": 0}
    db = sqlite3.connect(index_uri(), uri=True)
    terms = re.findall(r"\w+", query)
    if not terms:
        return {"mode": "empty", "hits": [], "more": 0}
    folders = list(CANONICAL) + (["journal", "inbox"] if scope == "all" else [])
    placeholders = ",".join("?" * len(folders))
    weight_sql = ("CASE folder " + " ".join("WHEN ? THEN ?" for _ in FOLDER_WEIGHTS)
                  + " ELSE 1.0 END")
    weight_params = [v for pair in FOLDER_WEIGHTS.items() for v in pair]
    rows, total, mode = [], 0, "none"
    for joiner, mode_name in ((" AND ", "all-terms"), (" OR ", "any-term")):
        match = joiner.join(f'"{t}"' for t in terms)
        try:
            rows = db.execute(
                f"SELECT id, path, title, folder, kind, created, "
                f"snippet(fts, 3, '[', ']', '…', 14), "
                f"bm25(fts, {BM25_WEIGHTS}) * ({weight_sql}) AS score "
                f"FROM fts WHERE fts MATCH ? AND folder IN ({placeholders}) "
                f"ORDER BY score LIMIT ?",
                (*weight_params, match, *folders, limit),
            ).fetchall()
            if rows:
                total = db.execute(
                    f"SELECT COUNT(*) FROM fts WHERE fts MATCH ? "
                    f"AND folder IN ({placeholders})", (match, *folders)).fetchone()[0]
        except sqlite3.OperationalError:
            rows = []
        if rows:
            mode = mode_name
            break
    if not rows:
        like = f"%{terms[0]}%"
        rows = db.execute(
            f"SELECT id, path, title, folder, kind, created, substr(body, 1, 120), 0.0 "
            f"FROM fts WHERE (title LIKE ? OR body LIKE ?) AND folder IN ({placeholders}) "
            f"ORDER BY folder, id LIMIT ?",
            (like, like, *folders, limit),
        ).fetchall()
        if rows:
            total = db.execute(
                f"SELECT COUNT(*) FROM fts WHERE (title LIKE ? OR body LIKE ?) "
                f"AND folder IN ({placeholders})", (like, like, *folders)).fetchone()[0]
        mode = "substring" if rows else "none"
    hits = [
        {"id": r[0], "path": r[1], "title": r[2], "folder": r[3], "kind": r[4],
         "created": r[5], "snippet": " ".join(str(r[6]).split())}
        for r in rows
    ]
    # Currency, from the notes_meta table the index already builds. `brain read`
    # has always warned on a draft or a passed review_by; search never did, so
    # the ranked list — the surface a caller actually answers from — presented a
    # stale or unfinished note identically to a settled one. Carried here rather
    # than as FTS columns so the schema and BM25 weights stay untouched.
    if hits:
        try:
            marks = dict((r[0], (r[1], r[2])) for r in db.execute(
                "SELECT id, status, review_by FROM notes_meta WHERE id IN "
                f"({','.join('?' * len(hits))})", [h["id"] for h in hits]))
        except sqlite3.OperationalError:
            marks = {}                     # index predates notes_meta
        today = date.today().isoformat()
        for h in hits:
            status, review_by = marks.get(h["id"], (None, None))
            h["status"] = status
            h["stale"] = bool(review_by and DATE_RE.match(str(review_by))
                              and str(review_by) < today)
            h["review_by"] = review_by
    return {"mode": mode, "hits": hits, "more": max(0, total - len(hits))}


def do_links(note_id: str, rebuild: bool = True) -> dict:
    """The [[wikilink]] neighbourhood of one note: what it points at, and what
    points back at it.

    Backlinks are the half a plain file tree cannot answer: 'what else refers to
    this?' is invisible to grep once a note is referenced by a display alias.
    Returns {"outbound": [...], "inbound": [...], "unresolved": [...]} where
    each entry carries id/title/path when the target is a real indexed note."""
    import sqlite3
    if rebuild and index_stale():
        cmd_index(quiet=True, skip_if_fresh=True)
    elif not rebuild and not INDEX_DB.exists():
        # First-ever use (fresh clone): build once so backlinks work at all.
        # Staleness alone still does NOT trigger a rebuild here — callers like
        # `brain read` must never pay an O(N) reindex just to show context.
        try:
            cmd_index(quiet=True, skip_if_fresh=True)
        except Exception:
            pass
    if not INDEX_DB.exists():
        return {"outbound": [], "inbound": [], "unresolved": [], "available": False}
    try:
        db = sqlite3.connect(index_uri(), uri=True)
    except sqlite3.Error:
        return {"outbound": [], "inbound": [], "unresolved": [], "available": False}
    try:
        def describe(ids):
            found, missing = [], []
            for nid in ids:
                row = db.execute(
                    "SELECT id, title, path, kind, folder FROM fts WHERE id = ? LIMIT 1",
                    (nid,)).fetchone()
                if row:
                    found.append({"id": row[0], "title": row[1], "path": row[2],
                                  "kind": row[3], "folder": row[4]})
                else:
                    missing.append(nid)
            return found, missing

        try:
            out_ids = [r[0] for r in db.execute(
                "SELECT DISTINCT dst FROM links WHERE src = ? ORDER BY dst", (note_id,))]
            in_ids = [r[0] for r in db.execute(
                "SELECT DISTINCT src FROM links WHERE dst = ? ORDER BY src", (note_id,))]
        except sqlite3.OperationalError:
            # Index predates the links table — it will gain one on next rebuild.
            return {"outbound": [], "inbound": [], "unresolved": [], "available": False}
        outbound, unresolved = describe(out_ids)
        inbound, _ = describe(in_ids)
        return {"outbound": outbound, "inbound": inbound, "unresolved": unresolved,
                "available": True}
    finally:
        db.close()


def format_links(note_id: str, result: dict) -> str:
    if not result.get("available"):
        return ("link graph unavailable (no search index yet) — run: bin/brain index")
    lines = [f"# links for {note_id}"]
    if result["inbound"]:
        lines.append(f"\nlinked FROM ({len(result['inbound'])}) — notes that reference this one:")
        for n in result["inbound"]:
            lines.append(f"  <- {n['id']}  {n['title']} ({n['path']})")
    else:
        lines.append("\nlinked FROM: nothing references this note yet")
    if result["outbound"]:
        lines.append(f"\nlinks TO ({len(result['outbound'])}):")
        for n in result["outbound"]:
            lines.append(f"  -> {n['id']}  {n['title']} ({n['path']})")
    else:
        lines.append("\nlinks TO: none")
    if result["unresolved"]:
        lines.append(f"\nUNRESOLVED targets ({len(result['unresolved'])}) — these point at no "
                     "current note (superseded, archived, or a typo):")
        for nid in result["unresolved"]:
            lines.append(f"  -> [[{nid}]]  ?")
    return "\n".join(lines)


def cmd_links(argv: list) -> int:
    import json as _json
    args = [a for a in argv if not a.startswith("--")]
    if not args:
        print("usage: brain links <id-or-path> [--json]")
        return 2
    wanted = args[0]
    metas = all_metas()
    note_id = wanted
    if wanted not in metas:
        # Accept a path too, so `brain links knowledge/decisions/x.md` works.
        candidate = resolve_note_path(wanted)
        if candidate is not None:
            fm, _err = parse_frontmatter(read_text(candidate))
            if fm and fm.get("id"):
                note_id = str(fm["id"])
        if note_id == wanted and wanted not in metas:
            print(f"note {wanted!r} not found (by id or path)")
            return 1
    result = do_links(note_id)
    print(_json.dumps(result, indent=2) if "--json" in argv
          else format_links(note_id, result))
    return 0


def format_hits(result: dict) -> str:
    if not result["hits"]:
        return ("no hits — rewrite the query into 2-3 lexical variants (synonyms, "
                "singular/plural) before concluding the brain has nothing")
    lines = []
    for i, h in enumerate(result["hits"], 1):
        tag = ""
        if h["folder"] == "inbox":
            tag = " [provisional — unconsolidated]"
        elif h["folder"] == "journal":
            tag = " [journal]"
        # status: current is the norm and says nothing; anything else is news.
        if h.get("status") and h["status"] != "current":
            tag += f" [status: {h['status']}]"
        if h.get("stale"):
            tag += f" [STALE — review_by {h['review_by']} passed]"
        lines.append(f"{i}. {h['path']} — {h['title']} ({h['kind']}, {h['created'] or 'n/a'}){tag}")
        if h["snippet"]:
            lines.append(f"   {h['snippet']}")
    if result["more"]:
        lines.append(f"({result['more']} more hits below the cap — narrow the query to see them)")
    lines.append(f"[match mode: {result['mode']}]")
    return "\n".join(lines)


def cmd_search(argv: list) -> int:
    import json as _json
    scope, limit, as_json, terms = "canonical", 8, False, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--scope" and i + 1 < len(argv):
            scope = argv[i + 1]
            i += 2
        elif a == "--limit" and i + 1 < len(argv):
            try:
                limit = max(1, int(argv[i + 1]))
            except ValueError:
                pass
            i += 2
        elif a == "--json":
            as_json = True
            i += 1
        elif a == "--":
            # End of options: everything after is query text, so a search for
            # "--scope" finds notes about --scope instead of silently parsing
            # it as a flag and searching for nothing.
            terms.extend(argv[i + 1:])
            break
        elif a.startswith("--"):
            i += 1
        else:
            terms.append(a)
            i += 1
    if scope not in ("canonical", "all"):
        scope = "canonical"
    if not terms:
        print("usage: brain search \"<query>\" [--scope canonical|all] [--limit N] [--json]")
        return 2
    result = do_search(" ".join(terms), scope=scope, limit=limit)
    print(_json.dumps(result, indent=2) if as_json else format_hits(result))
    return 0


def all_metas_scan() -> dict:
    """Authoritative id -> (rel, frontmatter) map, read from the notes themselves."""
    metas = {}
    for rel, (fm, _err) in collect_notes().items():
        if fm and fm.get("id"):
            metas[fm["id"]] = (rel, fm)
    return metas


def all_metas() -> dict:
    """id -> (rel, frontmatter) for every note, served from .cache when fresh.

    Re-reading and re-parsing every note just to turn one id into one path made
    `brain read` — the verb every retrieval flow ends in — scale with the size
    of the whole brain. The cache is only ever a FAST PATH: it is used solely
    when the index is fresh (same check that guards search), and any failure to
    read it falls through to the authoritative scan. Notes remain the truth;
    this is derived and disposable like every other index here.
    """
    import json as _json
    import sqlite3
    try:
        if index_stale() or not INDEX_DB.exists():
            return all_metas_scan()
        db = sqlite3.connect(index_uri(), uri=True)
        try:
            rows = db.execute("SELECT id, rel, fm_json FROM notes_meta").fetchall()
        finally:
            db.close()
    except Exception:
        return all_metas_scan()
    if not rows:
        # An empty table on a repo that clearly has notes means the cache was
        # built by an older version; don't hand back an empty brain.
        return all_metas_scan()
    metas = {}
    try:
        for note_id, rel, fm_json in rows:
            metas[note_id] = (Path(rel), _json.loads(fm_json))
    except (ValueError, TypeError):
        return all_metas_scan()
    return metas


class MetaIndex:
    """id/path lookups for single notes, O(1) against .cache when it is fresh.

    `brain read` needs one id and the two or three hops of its supersede chain —
    never the whole corpus — so materialising every note's frontmatter to answer
    it was the wrong shape. This resolves one row at a time and degrades to the
    authoritative full scan the moment the cache is missing, stale or
    unreadable, so a cold or broken .cache costs speed, never correctness.
    """

    def __init__(self, require_fresh: bool = True):
        self._db = None
        self._fallback = None
        import sqlite3
        try:
            if not INDEX_DB.exists() or (require_fresh and index_stale()):
                raise RuntimeError("stale")
            db = sqlite3.connect(index_uri(), uri=True)
            db.execute("SELECT 1 FROM notes_meta LIMIT 1").fetchone()
            self._db = db
        except Exception:
            self._fallback = all_metas_scan()

    def _row(self, sql, args):
        import json as _json
        try:
            row = self._db.execute(sql, args).fetchone()
        except Exception:
            return None
        if not row:
            return None
        try:
            return Path(row[0]), _json.loads(row[1])
        except (ValueError, TypeError):
            return None

    def get(self, note_id):
        """(rel, frontmatter) for an id, or None."""
        if self._db is None:
            return self._fallback.get(note_id)
        return self._row("SELECT rel, fm_json FROM notes_meta WHERE id = ? LIMIT 1",
                         (note_id,))

    def by_rel(self, rel):
        """(id, rel, frontmatter) for a knowledge/-relative path, or None."""
        if self._db is None:
            for note_id, (nrel, fm) in self._fallback.items():
                if nrel == rel:
                    return note_id, nrel, fm
            return None
        import json as _json
        try:
            row = self._db.execute(
                "SELECT id, rel, fm_json FROM notes_meta WHERE rel = ? LIMIT 1",
                (str(rel),)).fetchone()
        except Exception:
            return None
        if not row:
            return None
        try:
            return row[0], Path(row[1]), _json.loads(row[2])
        except (ValueError, TypeError):
            return None

    def exists(self, note_id) -> bool:
        if self._db is None:
            return note_id in self._fallback
        try:
            return self._db.execute("SELECT 1 FROM notes_meta WHERE id = ? LIMIT 1",
                                    (note_id,)).fetchone() is not None
        except Exception:
            return False

    def get_all(self, note_id) -> list:
        """EVERY row recorded for an id, not just one.

        An id can legitimately appear more than once here — that is exactly the
        state duplicate detection exists to catch — so a LIMIT 1 lookup can hand
        back the very row the caller is trying to look past."""
        import json as _json
        if self._db is None:
            hit = self._fallback.get(note_id)
            return [hit] if hit else []
        try:
            rows = self._db.execute(
                "SELECT rel, fm_json FROM notes_meta WHERE id = ?", (note_id,)).fetchall()
        except Exception:
            return []
        out = []
        for rel, fm_json in rows:
            try:
                out.append((Path(rel), _json.loads(fm_json)))
            except (ValueError, TypeError):
                continue
        return out

    def who_supersedes(self, target_id) -> list:
        """Ids of notes claiming `supersedes: target_id`. A column lookup, so
        the gate can detect a forked supersede without reading every note."""
        if self._db is None:
            return [nid for nid, (_rel, fm) in self._fallback.items()
                    if fm.get("supersedes") == target_id]
        try:
            return [r[0] for r in self._db.execute(
                "SELECT id FROM notes_meta WHERE supersedes = ?", (target_id,))]
        except Exception:
            return []

    def overdue(self, today_iso) -> list:
        """Ids whose review_by has passed — a column query, never a full parse."""
        if self._db is None:
            return [nid for nid, (_rel, fm) in self._fallback.items()
                    if fm.get("review_by") and str(fm["review_by"]) < today_iso]
        try:
            return [r[0] for r in self._db.execute(
                "SELECT id FROM notes_meta WHERE review_by IS NOT NULL AND review_by < ?",
                (today_iso,))]
        except Exception:
            return []

    def close(self):
        if self._db is not None:
            try:
                self._db.close()
            except Exception:
                pass


def resolve_note_path(wanted: str):
    """Resolve a path request to a real .md file strictly INSIDE knowledge/, else None.

    brain_read is exposed to any agent over MCP, so this is a trust
    boundary, not a convenience: resolve() collapses '..' and follows symlinks,
    then relative_to() proves the real target still sits under knowledge/. A
    path that escapes — 'knowledge/../../secrets', an absolute path, a symlink
    pointing out of the tree — resolves outside K and is refused here.
    """
    raw = Path(wanted)
    if raw.is_absolute():
        candidate = raw
    else:
        # Accept both 'knowledge/x.md' and bare 'x.md' forms.
        rel = Path(*raw.parts[1:]) if raw.parts and raw.parts[0] == "knowledge" else raw
        candidate = K / rel
    try:
        real = candidate.resolve()
        real.relative_to(K.resolve())
    except (ValueError, OSError, RuntimeError):
        return None
    if not real.is_file() or real.suffix.lower() != ".md":
        return None
    return real


def cmd_read(argv: list) -> int:
    args = [a for a in argv if not a.startswith("--")]
    if not args:
        print("usage: brain read <id-or-path>")
        return 2
    wanted = args[0]
    metas = MetaIndex()
    target_id = None
    if metas.get(wanted) is not None:
        target_id = wanted
    else:
        p = Path(wanted)
        try:
            rel = (ROOT / p).resolve().relative_to(K) if not str(p).startswith("knowledge/") \
                else Path(*Path(wanted).parts[1:])
        except ValueError:
            rel = None
        if rel is not None:
            found = metas.by_rel(rel)
            if found:
                target_id = found[0]
    if target_id is None:
        candidate = resolve_note_path(wanted)
        if candidate is not None:
            # Notes with no frontmatter id (inbox captures, journal entries)
            # reach here. They are provisional/dated, never canonical — say so
            # before dumping the body, exactly as the id path does below.
            try:
                top = candidate.resolve().relative_to(K.resolve()).parts[0]
            except (ValueError, OSError):
                top = ""
            if top == "inbox":
                print("WARNING: this is an INBOX capture — PROVISIONAL, not consolidated "
                      "knowledge. Do not present it as settled.\n")
            elif top == "journal":
                print("NOTE: this is a JOURNAL entry — a dated observation, not canonical "
                      "knowledge.\n")
            elif top == "archive":
                print("WARNING: this note is ARCHIVED/superseded — HISTORY, not current. "
                      "Cite it only as 'previously…'.\n")
            print(read_text(candidate))
            return 0
        print(f"note {wanted!r} not found (by id or path)")
        return 1

    chain = []
    seen = set()
    current_id = target_id
    while True:
        rel, fm = metas.get(current_id)
        successor = fm.get("superseded_by")
        if fm.get("status") == "superseded" and current_id not in seen \
                and isinstance(successor, str) and metas.get(successor) is not None:
            seen.add(current_id)
            chain.append(current_id)
            current_id = successor
        else:
            break
    rel, fm = metas.get(current_id)
    # Same trust boundary as the path branch: a note reached by id is still
    # read off disk, and a symlinked .md inside knowledge/ would otherwise
    # hand back whatever it points at.
    body_path = resolve_note_path(str(K / rel))
    if body_path is None:
        print(f"note {current_id!r} resolves outside knowledge/ — refused")
        return 1
    print(f"# {fm.get('title')}  ({fm.get('kind')}, created {fm.get('created')}, status {fm.get('status')})")
    print(f"path: knowledge/{rel}")
    if chain:
        print(f"NOTE: {wanted!r} was superseded — this is the CURRENT version. "
              f"Chain: {' -> '.join(chain + [current_id])}")
    if fm.get("supersedes"):
        print(f"history: supersedes [[{fm['supersedes']}]] (archived)")
    # Surface staleness/provenance the caller cannot see from the body alone, so
    # a model never presents unverified or historical content as settled truth.
    top = rel.parts[0]
    if top == "archive" or fm.get("status") == "superseded":
        print("WARNING: this note is ARCHIVED/superseded — it is HISTORY, not current. "
              "Cite it only as 'previously…', never as true today.")
    elif top == "inbox":
        print("WARNING: this is an INBOX capture — PROVISIONAL, not consolidated knowledge. "
              "Do not present it as settled.")
    elif top == "journal":
        print("NOTE: this is a JOURNAL entry — a dated observation, not canonical knowledge.")
    review_by = fm.get("review_by")
    if review_by and str(review_by) < date.today().isoformat():
        print(f"WARNING: review_by {review_by} has passed — this fact may be STALE; verify "
              "before relying on it.")
    # Backlinks: the context a lone note body cannot carry — what else in the
    # brain refers to this. Never triggers an index rebuild; a stale or missing
    # index simply means no graph line, not a slow read.
    graph = do_links(current_id, rebuild=False)
    if graph.get("inbound"):
        refs = ", ".join(f"[[{n['id']}]]" for n in graph["inbound"][:12])
        more = "" if len(graph["inbound"]) <= 12 else f" (+{len(graph['inbound']) - 12} more)"
        print(f"linked from ({len(graph['inbound'])}): {refs}{more}")
    print()
    print(read_text(body_path))
    return 0


def cmd_recent(argv: list) -> int:
    days = 7
    for i, a in enumerate(argv):
        if a == "--days" and i + 1 < len(argv):
            try:
                days = max(1, int(argv[i + 1]))
            except ValueError:
                print(f"--days needs an integer, got {argv[i + 1]!r}")
                return 2
    cutoff = time.time() - days * 86400
    rows = []
    for path in K.rglob("*.md"):
        top = path.relative_to(K).parts[0]
        if top in ("archive", "vault") or path.name in EXEMPT_NAMES:
            continue
        if path.stat().st_mtime >= cutoff:
            rows.append((path.stat().st_mtime, path))
    if not rows:
        print(f"no notes touched in the last {days} day(s)")
        return 0
    for mtime, path in sorted(rows, reverse=True)[:30]:
        day = time.strftime("%Y-%m-%d", time.localtime(mtime))
        # Same provisional discipline format_hits applies. Without it `recent`
        # listed a raw inbox capture and a settled decision in one undifferentiated
        # column — and recent is exactly the surface a caller reaches for when
        # asking "what was I just working on".
        top = path.relative_to(K).parts[0]
        tag = (" [provisional — unconsolidated]" if top == "inbox"
               else " [journal]" if top == "journal" else "")
        print(f"{day}  {path.relative_to(ROOT)}{tag}")
    return 0


def fm_update(path: Path, updates: dict, banner: str = None) -> None:
    """Set flat frontmatter fields in place (add if missing); optionally insert a
    banner line right after the frontmatter block."""
    lines = read_text(path).splitlines()
    end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    done = set()
    for i in range(1, end):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*):", lines[i])
        if m and m.group(1) in updates:
            lines[i] = f"{m.group(1)}: {updates[m.group(1)]}"
            done.add(m.group(1))
    for key, value in updates.items():
        if key not in done:
            lines.insert(end, f"{key}: {value}")
            end += 1
    if banner:
        lines.insert(end + 1, "")
        lines.insert(end + 2, banner)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def cmd_supersede(argv: list) -> int:
    args = [a for a in argv if not a.startswith("--")]
    if len(args) < 2:
        print('usage: brain supersede <old-id> "<new title>" [--topics a,b]')
        return 2
    old_id, title = args[0], args[1]
    metas = all_metas()
    if old_id not in metas:
        print(f"note {old_id!r} not found")
        return 1
    old_rel, old_fm = metas[old_id]
    if old_rel.parts[0] == "archive":
        print(f"{old_id!r} is already archived (superseded_by: "
              f"{old_fm.get('superseded_by')})")
        return 1
    folder = old_rel.parts[0]
    kind = FOLDER_KIND.get(folder)
    if kind == "project":
        print("projects are containers, not single facts — supersede a specific note "
              "inside the project instead")
        return 1

    topics_arg = ""
    for i, a in enumerate(argv):
        if a == "--topics" and i + 1 < len(argv):
            topics_arg = argv[i + 1]
    old_topics = old_fm.get("topics") or []
    if not isinstance(old_topics, list):
        old_topics = [old_topics]
    chosen = ([t.strip() for t in topics_arg.split(",") if t.strip()] or old_topics)

    today = date.today().isoformat()
    slug = slugify(title)
    new_id = unique_id(f"{today}-{slug}" if kind == "decision" else slug)
    new_path = K / folder / f"{new_id}.md"
    dest = K / "archive" / old_rel

    # unique_id() only guarantees the frontmatter *id* is free; it says nothing
    # about the file *path*, and lint never requires filename==id. Writing over
    # an existing note here would silently destroy its body (the template is
    # blank), and overwriting an archived note would rewrite append-only
    # history — both forbidden by AGENTS.md. Refuse before touching disk.
    if new_path.exists():
        print(f"a note already exists at {new_path.relative_to(ROOT)} — superseding would "
              "overwrite its content. Choose a different title.")
        return 1
    if dest.exists():
        print(f"{dest.relative_to(ROOT)} already exists — archive history is append-only and "
              "must never be overwritten. Resolve that first.")
        return 1

    new_path.write_text(
        render_template(kind, {
            "ID": new_id, "TITLE": title, "DATE": today,
            "TOPICS": ", ".join(chosen),
            "SENSITIVITY": old_fm.get("sensitivity") or "normal",
        }),
        encoding="utf-8",
    )
    fm_update(new_path, {"supersedes": old_id})

    old_path = K / old_rel
    fm_update(old_path, {"status": "superseded", "superseded_by": new_id},
              banner=f"> SUPERSEDED {today} by [[{new_id}]] — <one-line reason>")
    dest.parent.mkdir(parents=True, exist_ok=True)
    # git mv stages a rename, so it is an index mutation like any commit and
    # takes the same lock: unguarded, a capture committing in the same instant
    # could sweep half-finished supersede state into its own commit, or lose to
    # git's own index.lock and report the archive move as failed.
    with repo_lock():
        moved = subprocess.run(["git", "mv", str(old_path), str(dest)], cwd=ROOT,
                               capture_output=True, text=True)
    if moved.returncode != 0:
        # git mv can fail for benign reasons (path not yet tracked); fall back to
        # a plain move — but never over an existing archive file (history is
        # append-only), which could have appeared since the guard above.
        if dest.exists():
            print(f"git mv failed and {dest.relative_to(ROOT)} now exists — refusing to "
                  f"overwrite history. The new note {new_path.relative_to(ROOT)} was created; "
                  "move the old note into archive/ by hand.")
            return 1
        old_path.replace(dest)

    print(f"created:  {new_path}")
    print(f"archived: {dest}")
    tail = ("" if kind == "decision" else
            f" The previous content is preserved in {dest.relative_to(ROOT)} — copy across "
            "whatever still holds (supersede starts the new note from a blank template).")
    print("now: fill the new note's body and aliases, replace the '<one-line reason>' "
          "in the archived note's banner, run bin/brain lint, then commit." + tail)
    return 0


TRANSCRIPT_ROOT = Path.home() / ".claude" / "projects"

# Wrapper turns the CLI injects into the transcript as if they were typed.
_NOISE_PREFIXES = ("<local-command", "<command-name>", "<command-message>",
                   "<command-args>", "<bash-input>", "<bash-stdout>", "Caveat:",
                   # Machine payloads that arrive as TOP-LEVEL user turns and so
                   # survive the isSidechain filter: workflow/subagent returns
                   # pasted back by an orchestrator, and harness task events.
                   # Mining them laundered assistant prose into the user's
                   # recorded fact — under a header that promises the opposite.
                   "<result>", "<task-notification>", "<system-reminder>",
                   "[SYSTEM NOTIFICATION", "{\"final\":", "{'final':")
_REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)


def digest_path() -> Path:
    # Computed, not a module constant: main() rebinds ROOT for --root.
    return ROOT / ".cache" / "session-digest.md"


def _human_turns(path: Path, max_turn: int = 2000) -> tuple:
    """(timestamp, text) pairs for the user's OWN prompts in one transcript, + cwd.

    Assistant output is deliberately never extracted. The point of mining is to
    recover what the user decided, preferred and knew; feeding my own prose back
    into the brain would launder my speculation into their recorded fact.
    """
    import json as _json
    turns, cwd = [], ""
    try:
        raw = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return [], ""
    for line in raw.splitlines():
        if not line.strip():
            continue
        try:
            rec = _json.loads(line)
        except ValueError:
            continue
        if not isinstance(rec, dict) or rec.get("type") != "user":
            continue
        if rec.get("isSidechain"):
            continue                       # subagent traffic, not the user
        msg = rec.get("message")
        content = msg.get("content") if isinstance(msg, dict) else None
        if not isinstance(content, str):
            continue                       # list content == tool results
        cwd = cwd or str(rec.get("cwd") or "")
        text = _REMINDER_RE.sub("", content).strip()
        if not text or text.startswith(_NOISE_PREFIXES):
            continue
        if len(text) > max_turn:
            text = text[:max_turn] + " …[truncated]"
        turns.append((str(rec.get("timestamp") or "")[:19], text))
    return turns, cwd


def session_digest(days: int = 8, max_chars: int = 120_000) -> tuple:
    """(markdown, session_count) of recent human turns across all projects.

    Transcripts live outside the repo, so the consolidation model — which runs
    headless and cannot answer a permission prompt — could not read them
    itself. The wrapper materializes them into .cache/ (gitignored) first.
    """
    cutoff = time.time() - days * 86400
    # Transcript timestamps are ISO-8601 UTC, so lexical compare == chronological.
    cutoff_iso = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(cutoff))
    sessions = []
    if TRANSCRIPT_ROOT.is_dir():
        for path in sorted(TRANSCRIPT_ROOT.glob("*/*.jsonl")):
            try:
                mtime = path.stat().st_mtime
            except OSError:
                continue
            if mtime < cutoff:
                continue          # cheap pre-filter: mtime >= every turn in it
            turns, cwd = _human_turns(path)
            if not turns:
                continue
            # The real filter is when the user actually TALKED. A file merely
            # touched recently (reindexed, copied) can hold a months-old
            # conversation, and mining those would resurrect them every week.
            newest = max(ts for ts, _ in turns)
            if newest < cutoff_iso:
                continue
            sessions.append((newest, cwd, turns))

    sessions.sort(key=lambda s: s[0], reverse=True)   # trim the oldest first
    # Deduplicate turn TEXT across the whole digest. A resumed session replays
    # its earlier turns into a new transcript, so the same prompt was mined
    # repeatedly — the window check gates the FILE (newest turn) and then emits
    # every turn in it, including ones from weeks earlier. Hashing content rather
    # than filtering by per-turn timestamp keeps recent turns attached to the
    # older turns they refer to, and discards nothing that was said only once.
    seen_turns, blocks, used, kept, deduped_sessions = set(), [], 0, 0, 0
    for newest, cwd, turns in sessions:
        fresh = []
        for ts, text in turns:
            key = hashlib.sha256(text.encode("utf-8")).hexdigest()
            if key in seen_turns:
                continue
            seen_turns.add(key)
            fresh.append((ts, text))
        if not fresh:
            deduped_sessions += 1          # every turn already appeared above
            continue
        turns = fresh
        head = f"\n## {newest[:10]} — {cwd or 'unknown directory'}\n"
        # Blockquote every line: prompts often contain their own "## " headings,
        # which would otherwise be indistinguishable from a session boundary.
        body = "".join(
            "\n**[{}]**\n{}\n".format(ts, "\n".join("> " + ln for ln in text.splitlines()))
            for ts, text in turns)
        if used + len(head) + len(body) > max_chars and kept:
            break
        blocks.append((newest, head + body))
        used += len(head) + len(body)
        kept += 1

    blocks.sort(key=lambda b: b[0])                   # present chronologically
    dropped = len(sessions) - kept - deduped_sessions
    header = (f"# Session digest — {kept} session(s), last {days} days\n\n"
              "The user's own prompts only; assistant output is excluded by design.\n"
              "Provisional raw material for consolidation, not knowledge itself.\n")
    if dropped:
        header += f"\nNOTE: {dropped} older session(s) dropped at the size cap.\n"
    if not kept:
        header += "\nNo sessions in the window — nothing to mine.\n"
    return header + "".join(b for _, b in blocks), kept


def cmd_sessions(argv: list) -> int:
    days = 8
    for i, arg in enumerate(argv):
        if arg == "--days" and i + 1 < len(argv):
            try:
                days = max(1, int(argv[i + 1]))
            except ValueError:
                print("--days needs an integer")
                return 2
    text, count = session_digest(days=days)
    if "--stdout" in argv:
        print(text)
        return 0
    out = digest_path()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text, encoding="utf-8")
    print(f"session digest: {count} session(s), {len(text)} chars → {out}")
    if not count and not TRANSCRIPT_ROOT.is_dir():
        print(f"(no transcripts at {TRANSCRIPT_ROOT})")
    return 0


AUDIT_MAX_DIFF_CHARS = 200_000

CONSOLIDATOR_CONF = "setup/consolidator.conf"
# Today's behaviour, verbatim, for a clone whose conf file is missing. Not a
# fallback for a BROKEN conf — a present-but-invalid file is a refusal, because
# someone edited it and getting a silent Claude default instead of what they
# wrote is how a security boundary disappears without anyone noticing.
CONSOLIDATOR_DEFAULTS = {
    "model": "claude-opus-4-8",
    "propose": "claude --model {model} --permission-mode acceptEdits -p",
    "audit": "claude --model {model} -p",
    "audit_cannot_write": ("The Claude CLI grants no write tools in its default "
                           "headless mode; propose opts in with --permission-mode "
                           "acceptEdits and audit omits it."),
    "propose_timeout": "1800",
    "audit_timeout": "900",
}


class ConsolidatorConfigError(Exception):
    """A consolidator config that would silently weaken the audit boundary."""


def load_consolidator() -> dict:
    """The one pinned runner: two argv templates, a model, and a timeout each.

    Returns {'model', 'propose' (list), 'audit' (list), 'propose_timeout',
    'audit_timeout', 'audit_cannot_write', 'source'}. The prompt is NOT in the
    argv — callers append it as the final argument, so no prompt text is ever
    interpolated into a shell string.

    Raises ConsolidatorConfigError rather than falling back. The one thing this
    function must never do is quietly produce a working config from a broken
    one: the difference between the two invocations IS the audit boundary, and
    a boundary that repairs itself on the way past is not a boundary.
    """
    path = ROOT / CONSOLIDATOR_CONF
    conf, source = dict(CONSOLIDATOR_DEFAULTS), "built-in defaults"
    if path.exists():
        source = CONSOLIDATOR_CONF
        conf, key = {}, None
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.split("#", 1)[0].rstrip() if raw.lstrip().startswith("#") else raw.rstrip()
            if not line.strip():
                key = None
                continue
            if "=" in line and not line[:1].isspace():
                key, value = line.split("=", 1)
                key = key.strip()
                conf[key] = value.strip()
            elif key:
                # Continuation: an indented line extends the previous value, so
                # audit_cannot_write can be a paragraph rather than one long row.
                conf[key] = (conf[key] + " " + line.strip()).strip()

    missing = [k for k in ("model", "propose", "audit", "audit_cannot_write")
               if not conf.get(k, "").strip()]
    if missing:
        raise ConsolidatorConfigError(
            f"{source}: missing or empty {', '.join(missing)}")

    # The model must be ONE shell token. If it were substituted into the command
    # string before splitting, a value like `x --permission-mode acceptEdits`
    # would inject flags: it lands in BOTH invocations, so `propose != audit`
    # still holds, and the read-only auditor silently gains write access with
    # every refusal below still passing. That is the exact boundary this
    # function exists to guarantee, defeated through the one free-text field.
    if len(shlex.split(conf["model"])) != 1:
        raise ConsolidatorConfigError(
            f"{source}: model must be a single token — got {conf['model']!r}. A "
            "model field carrying flags would inject them into the auditor's "
            "command and hand a read-only pass the power to write.")

    def argv_for(field):
        try:
            parts = shlex.split(conf[field])   # split FIRST, substitute AFTER
        except ValueError as exc:
            raise ConsolidatorConfigError(f"{source}: {field} does not parse: {exc}")
        # Per-token replace, so {model} can only ever expand WITHIN one argv
        # element — never spawn new arguments, whatever the model string holds.
        parts = [p.replace("{model}", conf["model"]) for p in parts]
        if not parts:
            raise ConsolidatorConfigError(f"{source}: {field} is empty")
        return parts

    propose, audit = argv_for("propose"), argv_for("audit")
    # The refusal the plan for this system asks for by name. A runner whose two
    # invocations are identical has no audit boundary at all — the auditor
    # simply is the proposer, running twice, with the same power to write. That
    # is the failure mode of porting a command string across tools without
    # re-establishing what made the original safe.
    if propose == audit:
        raise ConsolidatorConfigError(
            f"{source}: propose and audit are the same command, so the auditor "
            "has exactly the write access the proposer does. The audit is a "
            "security boundary, not a second opinion — express the read-only "
            "invocation separately (see the comments in that file).")
    if len(conf["audit_cannot_write"].split()) < 8:
        raise ConsolidatorConfigError(
            f"{source}: audit_cannot_write must say HOW this runner is prevented "
            "from writing. The property is a fact about the specific tool, not "
            "something a command string carries with it — a runner that writes "
            "by default would inherit a 'read-only' audit that writes.")

    def seconds(field, fallback):
        try:
            value = int(conf.get(field) or fallback)
        except ValueError:
            raise ConsolidatorConfigError(f"{source}: {field} is not a whole number")
        if value <= 0:
            raise ConsolidatorConfigError(f"{source}: {field} must be positive")
        return value

    return {
        "model": conf["model"], "propose": propose, "audit": audit,
        "propose_timeout": seconds("propose_timeout", CONSOLIDATOR_DEFAULTS["propose_timeout"]),
        "audit_timeout": seconds("audit_timeout", CONSOLIDATOR_DEFAULTS["audit_timeout"]),
        "audit_cannot_write": conf["audit_cannot_write"], "source": source,
    }


def staged_diff_vs_main() -> tuple:
    """(diff_text, error). The plain git() helper returns '' on failure, which a
    caller cannot tell from 'nothing changed' — and reading a failed diff as an
    empty one would skip the audit and call it a pass. This one reports.

    The trunk is resolved, not assumed to be `main` — but resolution must not
    become a way to pass. default_branch() falls back to the CURRENT branch when
    it can find no trunk at all, and here that would diff the consolidation
    branch against itself: an empty diff, no auditor spawned, verdict pass. So
    the trunk is verified to exist and to be something other than where we are
    standing, and anything else fails closed.
    """
    trunk = default_branch()
    if not git("rev-parse", "--verify", "--quiet", f"refs/heads/{trunk}"):
        return "", f"no trunk branch to diff against (looked for {trunk!r})"
    if git("rev-parse", "--abbrev-ref", "HEAD") == trunk:
        return "", f"refusing to audit {trunk!r} against itself"
    result = subprocess.run(["git", "diff", "--cached", trunk], cwd=ROOT,
                            capture_output=True, text=True)
    if result.returncode != 0:
        return "", ((result.stderr or "").strip()[-200:] or "git diff failed")
    return result.stdout, None


def audit_changes(runner: dict, timeout: int = None) -> tuple:
    """Independently audit the staged consolidation diff. Returns (verdict, detail)
    where verdict is 'pass', 'block' or 'error'.

    Why a second agent here and nowhere else in this system: the pass that reads
    93k characters of untrusted session transcript is the same pass that decides
    what becomes permanent knowledge. Injection surface and judgment authority in
    one context is the one place where a fresh reader is strictly better than the
    author — and it runs weekly, unattended, so the latency that rules delegation
    out on every interactive path costs nothing here.

    Two properties make this a boundary rather than a second opinion:

    - The auditor CANNOT WRITE. It runs the `audit` invocation from
      setup/consolidator.conf, which for the default runner is headless with no
      write tools granted. Two prompts with identical write permissions would be
      theatre, so load_consolidator() refuses a config where the two invocations
      are the same command.
    - The auditor CANNOT READ THE DIGEST. The file is moved out of the repo for
      the duration, not merely left unmentioned. Blindness has to be a fact of
      the filesystem; a prompt asking it not to look is not a control.

    Fails CLOSED: a missing or unparseable verdict blocks. The work is preserved
    on the branch and `bin/brain doctor` reports unreviewed consolidation
    branches, so a blocked pass is visible and recoverable — an unaudited push
    into permanent history is not.
    """
    import shutil
    import tempfile

    timeout = runner["audit_timeout"] if timeout is None else timeout
    prompt_path = ROOT / "setup" / "audit-prompt.md"
    if not prompt_path.exists():
        return "error", "missing setup/audit-prompt.md"
    diff, diff_error = staged_diff_vs_main()
    if diff_error:
        return "error", f"could not read the staged diff to audit it: {diff_error}"
    if not diff.strip():
        return "pass", "no staged changes to audit"
    truncated = len(diff) > AUDIT_MAX_DIFF_CHARS
    if truncated:
        # Not silently trimmed: the caps in the consolidation prompt make a diff
        # this large abnormal on its own, and auditing a fraction of a change set
        # while reporting a pass would be worse than not auditing at all.
        diff = diff[:AUDIT_MAX_DIFF_CHARS]

    prompt = (prompt_path.read_text(encoding="utf-8")
              + "\n\n```diff\n" + diff + "\n```\n")
    if truncated:
        prompt += ("\nNOTE: this diff was TRUNCATED at "
                   f"{AUDIT_MAX_DIFF_CHARS} characters — it exceeds what a pass "
                   "respecting its own caps can produce. Block on that alone.\n")

    # Move the digest OUT OF THE REPO for the duration. The auditor runs with
    # cwd=ROOT and can glob .cache/, so renaming in place would not blind it.
    stash_dir = tempfile.mkdtemp(prefix="brain-audit-")
    digest, hidden = digest_path(), None
    try:
        if digest.exists():
            hidden = Path(stash_dir) / "session-digest.md"
            shutil.move(str(digest), str(hidden))
        try:
            run = subprocess.run(
                [*runner["audit"], prompt],
                cwd=ROOT, text=True, capture_output=True, timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            return "error", f"auditor timed out after {timeout}s"
        except (OSError, subprocess.SubprocessError) as exc:
            return "error", f"could not run the auditor: {exc!r}"
    finally:
        if hidden is not None and hidden.exists():
            try:
                shutil.move(str(hidden), str(digest))
            except OSError:
                pass
        shutil.rmtree(stash_dir, ignore_errors=True)

    out = (run.stdout or "").strip()
    if run.returncode != 0:
        return "error", (f"auditor exited {run.returncode}: "
                         f"{(run.stderr or '').strip()[-300:] or 'no stderr'}")
    verdict_lines = [l.strip() for l in out.splitlines()
                     if l.strip().upper().startswith("VERDICT:")]
    if not verdict_lines:
        return "error", "auditor returned no VERDICT line — treating as blocked"
    final = verdict_lines[-1]
    body = final.split(":", 1)[1].strip()
    if body.upper().startswith("PASS"):
        return "pass", "no safety or conflict findings"
    reason = body.split("—", 1)[-1].strip() if "—" in body else body
    # The findings themselves are the useful part; keep them with the branch.
    try:
        (ROOT / ".cache").mkdir(exist_ok=True)
        (ROOT / ".cache" / "audit-report.md").write_text(out, encoding="utf-8")
    except OSError:
        pass
    return "block", (reason or "unspecified")[:300] + " (full report: .cache/audit-report.md)"


def cmd_consolidate(argv: list) -> int:
    prompt_path = ROOT / "setup" / "consolidate-prompt.md"
    if not prompt_path.exists():
        print("missing setup/consolidate-prompt.md")
        return 1
    inbox_items = [p for p in (K / "inbox").glob("*.md")]
    audit_path = ROOT / "setup" / "audit-prompt.md"
    # Resolve the runner BEFORE anything else, --dry-run included. A config that
    # would drop the audit boundary must fail here, on the ground, rather than
    # after a branch has been cut and a model has spent half an hour writing.
    try:
        runner = load_consolidator()
    except ConsolidatorConfigError as exc:
        print(f"consolidation refused — {exc}")
        return 1
    if "--dry-run" in argv:
        print(f"would consolidate: {len(inbox_items)} inbox item(s)")
        _, sessions = session_digest()
        print(f"would mine: {sessions} recent session(s)")
        print(f"prompt: {prompt_path}")
        print(f"audit:  {audit_path}"
              + ("" if audit_path.exists() else "  [MISSING — the pass would block]"))
        print(f"runner: {' '.join(runner['propose'])} …  ({runner['source']})")
        print(f"        auditor runs read-only as: {' '.join(runner['audit'])} …")
        return 0
    if not audit_path.exists():
        print("missing setup/audit-prompt.md — the audit gate cannot run, and an "
              "unaudited pass must not reach the remote")
        return 1
    today = date.today().isoformat()
    # Clean-tree test, branch naming and the switch are one atomic step. Split
    # apart they were three separate races: a capture could commit between the
    # test and the switch (dirtying a tree already declared clean), two passes
    # could pick the same branch name, and a capture could read "main" from HEAD
    # a moment before the switch and then commit onto the consolidation branch.
    # The lock is NOT held across the model run below — that would stall every
    # capture for up to half an hour, past the MCP layer's own timeout.
    with repo_lock():
        if git("status", "--porcelain").strip():
            print("working tree not clean — commit or stash first, then rerun")
            return 1
        branch = f"consolidate/{today}"
        if git("branch", "--list", branch):
            branch = f"{branch}-{time.strftime('%H%M')}"
        subprocess.run(["git", "checkout", "-b", branch], cwd=ROOT, check=True)
    print(f"brain consolidate: running {runner['propose'][0]} ({runner['model']}) "
          f"on branch {branch} (runner pinned in {runner['source']})…")

    # Materialize the session digest BEFORE handing over: the model runs
    # headless and cannot approve reads outside the repo. A failure here is not
    # fatal — draining the inbox is still worth doing on its own.
    try:
        text, sessions = session_digest()
        digest_path().parent.mkdir(parents=True, exist_ok=True)
        digest_path().write_text(text, encoding="utf-8")
        print(f"  session digest: {sessions} session(s) → {digest_path()}")
    except Exception as exc:
        print(f"  session digest skipped: {exc!r}")
        try:
            digest_path().unlink()     # never let LAST week's digest be re-mined
        except OSError:
            pass

    # Every stage is gated on the previous one succeeding. This used to run the
    # commit and the push from a `finally:`, so a model that crashed, timed out
    # or wrote garbage still got its work committed AND pushed, and the closing
    # message claimed the consolidation had landed either way.
    failure = None
    runner_name = runner["propose"][0]
    try:
        run = subprocess.run(
            [*runner["propose"], prompt_path.read_text(encoding="utf-8")],
            cwd=ROOT, text=True, capture_output=True, timeout=runner["propose_timeout"],
        )
        print(run.stdout[-2000:] if run.stdout else "(no output)")
        if run.returncode != 0:
            failure = (f"{runner_name} exited {run.returncode}: "
                       f"{(run.stderr or '').strip()[-300:] or 'no stderr'}")
    except subprocess.TimeoutExpired:
        failure = f"{runner_name} timed out after {runner['propose_timeout']}s"
    except (OSError, subprocess.SubprocessError) as exc:
        failure = f"could not run {runner_name}: {exc!r}"

    dirty = bool(git("status", "--porcelain").strip())
    try:
        lint_code = lint()
    except Exception as exc:
        lint_code = 1
        failure = failure or f"lint crashed on the consolidated tree: {exc!r}"
    if lint_code != 0 and failure is None:
        failure = "lint rejected the consolidated tree"

    # Stage loose work FIRST, then measure the change set against main rather
    # than against the working tree. Two reasons, both load-bearing:
    #  - new canonical notes are UNTRACKED, so an unstaged `git diff main` shows
    #    the single most important thing to audit as nothing at all;
    #  - the consolidation prompt tells the proposer to commit its own output, so
    #    a clean tree is the DOCUMENTED happy path. Gating the audit on a dirty
    #    tree would skip it exactly when work was done.
    if failure is None and dirty:
        with repo_lock():
            subprocess.run(["git", "add", "-A"], cwd=ROOT, capture_output=True)
    staged, staged_error = staged_diff_vs_main()
    if staged_error and failure is None:
        failure = f"could not diff the branch against main: {staged_error}"
    changed = bool(staged.strip())

    if failure is None and changed:
        verdict, detail = audit_changes(runner)
        print(f"  audit: {detail}")
        if verdict != "pass":
            failure = f"audit {verdict}: {detail}"

    committed = pushed = False
    uncommitted = bool(git("diff", "--cached", "--name-only").strip())
    if failure is None and uncommitted:
        with repo_lock():
            commit = subprocess.run(["git", "commit", "-m", f"consolidate: {today}"],
                                    cwd=ROOT, capture_output=True, text=True)
        committed = commit.returncode == 0
        if not committed:
            failure = (f"commit rejected: "
                       f"{(commit.stderr or commit.stdout).strip()[-300:] or 'unknown'}")
    if failure is None and changed:
        push = subprocess.run(["git", "push", "-u", "origin", branch],
                              cwd=ROOT, capture_output=True, text=True)
        # Confirm against the REMOTE REF, not the exit code. post-commit used to
        # race this push for the same branch and win, leaving a correct push
        # reported as "PUSH FAILED" — advice that sends you to re-run a command
        # that then says "Everything up-to-date". The hook no longer touches
        # consolidate/*, but comparing what is actually on the remote is the
        # honest check either way.
        pushed = push.returncode == 0
        if not pushed:
            local = git("rev-parse", branch)
            remote = git("rev-parse", f"origin/{branch}")
            pushed = bool(local) and local == remote

    # Only step off the branch when nothing would be carried along with us —
    # tested and switched under the lock, so a capture landing in the gap cannot
    # be dragged onto main (or find HEAD moving mid-commit).
    with repo_lock():
        if not git("status", "--porcelain").strip():
            subprocess.run(["git", "checkout", default_branch()], cwd=ROOT, capture_output=True)
        here = git("rev-parse", "--abbrev-ref", "HEAD") or "?"

    print()
    if failure:
        print(f"consolidation DID NOT LAND: {failure}")
        print(f"nothing was pushed; the work is left on {branch} for inspection")
        if uncommitted:
            print("  (staged but not committed — inspect with: git diff --cached main)")
        print(f"you are on branch: {here}")
        return 1
    if not changed:
        print("consolidation made no changes — nothing to review")
        return 0
    print(f"consolidation committed on {branch} (never on main)"
          + ("" if pushed else " — PUSH FAILED, run: git push -u origin " + branch))
    print(f"review:  git diff main...{branch}")
    print(f"merge:   git merge {branch} && git push")
    return 0


# Paths relative to knowledge/ — the scaffolding a brain needs to exist, as
# opposed to anything the owner has actually written down. note-conventions is
# documentation of the system rather than knowledge about its owner, and an
# entirely empty brain is a bad first experience: a new user gets one worked
# example of a correct note instead of a blank folder.
TEMPLATE_KEEP_KNOWLEDGE = ("index.md", "topics.yaml", "vault/README.md",
                           "reference/note-conventions.md")
TEMPLATE_DROP = (
    "setup/vault-recipient.txt",   # the AUTHOR's age key — a stranger encrypting
                                   # to it could never read their own vault back
    ".mcp.json",                   # machine-local absolute paths
    "setup/skills/brain/SKILL.md",  # rendered per machine by `brain init`
    ".claude/settings.local.json",  # this machine's local Claude permissions
    ".claude/scheduled_tasks.lock",  # this machine's session UUID and pid
)

# The vocabulary a fresh brain starts with. topics.yaml escapes the note sweep
# because a brain with no vocabulary cannot lint — but the topic names ARE the
# author's projects, clients and preoccupations, listed in a file nobody thinks
# of as a note. Kept as literal text rather than filtered from the live file,
# so widening what ships is an edit here rather than an accident there.
TEMPLATE_TOPICS = """\
# Controlled topic vocabulary — one topic per line: "topic: alias, alias".
# Every note's `topics:` entries must come from this list. Adding a topic is a
# deliberate one-line commit; that discipline is what keeps scoped search
# working for decades (tags must not fragment into ml / ML / machine-learning).
#
# These four are the vocabulary this system needs to describe ITSELF. Replace
# and extend them with your own — that is the first real thing you will do here.
brain: second-brain, knowledge-base, memory
ai-tooling: agents, mcp, llm, tooling
retrieval: search, indexing, findability, ranking
conventions: schema, note-format, structure, frontmatter
"""


# Files where the publisher's own identity legitimately survives into the
# published copy: the copyright line has to name a person, the install doc has
# to name the repo people are installing FROM, and a plugin manifest's whole
# job is to say who wrote the plugin. Naming yourself on purpose is publishing,
# not leaking — but the exemption is per-FILE and deliberately tiny, because
# every entry here is a place the scan stops looking.
TEMPLATE_IDENTITY_OK = (
    "LICENSE",
    "SETUP.md",
    ".claude-plugin/marketplace.json",
    "plugins/brain/.claude-plugin/plugin.json",
)

# Words that would give the publisher away, plus the noise that would make the
# check useless if it were not filtered out.
IDENTITY_STOPWORDS = {
    "github", "gitlab", "https", "http", "www", "com", "org", "net", "git",
    "gmail", "mail", "icloud", "outlook", "hotmail", "users", "home", "brain",
    "main", "master", "origin", "second", "template", "repo", "none",
    # Machine account names. A home directory called `runner` or `ubuntu` names
    # a CI image, not a person, and treating it as the publisher's identity is
    # how this check used to fail every GitHub Actions run: the docs describe
    # "the pinned runner" dozens of times, so every emit refused itself.
    "runner", "ubuntu", "vagrant", "admin", "user", "root", "build", "builder",
    "worker", "docker", "jenkins", "travis", "circleci", "codespace", "deploy",
    "container", "azureuser", "ec2", "localhost", "unknown",
}


def publisher_identity_tokens() -> set:
    """Words that identify whoever is publishing, derived rather than listed.

    A hard-coded list of the author's names would have to live in bin/brain —
    the very file being published — which is the leak it exists to prevent. So
    the tokens come from git's own idea of who you are, plus your home
    directory name, which is how an absolute path smuggles a username into a
    generated file. Works for the next publisher too, without an edit.

    The 4-char floor is a false-positive guard, not a whim: a 2-3 char token
    matches far too much and would brick every emit. So a name or handle
    shorter than that is caught a different way — the whole value, punctuation
    stripped, is added too ("Li Wu" -> "liwu", "li.wu@x" -> "liwu"), which
    recovers the short-multiword case without lowering the floor into
    false-positive territory. A bare <4-char single-token handle is the one
    residual gap, documented as a known limit of a defense-in-depth check that
    sits on top of the note/secret/wiring scrubs, not under them.

    Two rules here exist because the naive version of this check was worse than
    useless — it refused to publish for a large fraction of real people:

    - The home directory name only counts as identity if git corroborates it.
      A home called `runner`, `ubuntu` or `admin` names a machine, not a
      person; trusting it made every CI run refuse its own emit. The absolute
      home PATH is still scanned, by publisher_identity_paths() below, which is
      the leak that actually matters (`/Users/jane/...` baked into a generated
      file) and which cannot false-positive.
    - Tokens are matched on WORD BOUNDARIES by the caller, never as bare
      substrings. Substring matching meant a publisher whose name is a prefix
      of an ordinary English word could not publish at all: m-a-r-k against
      "markdown", k-e-n against "token", p-a-t against "path", g-e-n-e against
      "generate", s-a-g-e against "usage". That was not a corner case, it was
      most of the name space. (Those examples are spelled out letter-by-letter
      on purpose: written normally they would be real words in this file, and
      this file is published — a publisher with one of those names would then
      trip the very check this comment explains.)
    """
    name = git("config", "user.name")
    email = git("config", "user.email")
    remote = git("remote", "get-url", "origin")
    local_part = email.split("@", 1)[0] if email else ""
    # The owner segment of the remote is the publisher's handle: the path
    # component just before the repo name in .../<owner>/<repo>(.git).
    owner = ""
    m = re.search(r"[/:]([^/:]+)/[^/]+?(?:\.git)?/?$", remote or "")
    if m:
        owner = m.group(1)

    def words(value: str) -> set:
        found = set()
        for word in re.split(r"[^A-Za-z0-9]+", value or ""):
            lowered = word.lower()
            if len(lowered) >= 4 and lowered not in IDENTITY_STOPWORDS:
                found.add(lowered)
        return found

    tokens = set()
    # The email LOCAL PART, never the domain: a domain names an organisation or
    # a machine, and tokenising it yields noise that matches everything
    # ("…@fv-az1.local" -> "local"). The address in full is matched verbatim by
    # publisher_identity_paths() instead, which is the form that actually leaks.
    #
    # The remote's OWNER, never the whole URL. Tokenising the URL pulled in the
    # repository NAME, which is not the publisher and is usually an ordinary
    # word: a brain whose remote was ".../brain-archive-2026-07" derived the
    # token "archive" and then refused to publish a tree containing
    # knowledge/archive/.
    for value in (name, local_part, owner):
        tokens |= words(value)
    # Whole, punctuation-stripped identity values, so a short multi-word name or
    # a dotted email local-part is caught even though its pieces are short.
    for whole in (name, local_part, owner):
        collapsed = re.sub(r"[^A-Za-z0-9]", "", whole or "").lower()
        if len(collapsed) >= 4 and collapsed not in IDENTITY_STOPWORDS:
            tokens.add(collapsed)
    # The home directory name, only if git already agrees it is a person.
    for candidate in words(Path.home().name):
        if candidate in tokens or any(candidate in t or t in candidate for t in tokens):
            tokens.add(candidate)
    return tokens


def publisher_identity_paths() -> set:
    """Absolute paths that would name the publisher if they survived into the
    published copy — the leak that a token scan cannot express.

    `/Users/<you>/brain` baked into a generated file gives away a username even
    when that username appears nowhere as a standalone word. Matched literally
    rather than by word boundary, because a path IS the giveaway and cannot
    collide with prose. (No example username is written out here: this file
    ships, so a real name in this comment would trip the check for whoever is
    actually called that.)
    The publisher's full email address is here for the same reason: it is
    unambiguous in full, while its parts are not.
    """
    home = str(Path.home()).rstrip("/")
    paths = set()
    # Same rule as the token scan, for the same reason: /home/runner and
    # /home/ubuntu name a CI image, not a person, so they are not a leak — and
    # treating them as one means any file that MENTIONS such a path (this
    # project's own tests do, documenting exactly this) fails the publish on
    # every CI run.
    if home and home not in ("/", "") and Path(home).name.lower() not in IDENTITY_STOPWORDS:
        paths.add(home)
    root = str(ROOT).rstrip("/")
    if root and root != home:
        paths.add(root)
    email = git("config", "user.email")
    if email and "@" in email:
        paths.add(email.strip())
    return paths


def cmd_template(argv: list) -> int:
    """Emit a publishable copy of this system with none of the owner's knowledge.

    The public template used to be a SEPARATE repo kept in sync by hand, which
    is the same mistake this project refuses everywhere else: two sources of
    truth. Here the template is DERIVED — regenerate it, never edit it — so a
    fix to the toolbelt can never be live in one and missing in the other.

    What ships: the toolbelt, hooks, CI, tests, docs and the folder skeleton.
    What never ships: a single one of your notes, your vault recipient, or any
    machine-local wiring.
    """
    import shutil
    # --allow-identity accepts either spelling: `--allow-identity a,b` or
    # `--allow-identity=a,b`. Its value must not be mistaken for the
    # destination, so both the flag and a detached value are consumed here.
    allowed_identity, args, skip_next = set(), [], False
    for i, arg in enumerate(argv):
        if skip_next:
            skip_next = False
            continue
        if arg.startswith("--allow-identity="):
            allowed_identity |= {t.strip().lower()
                                 for t in arg.split("=", 1)[1].split(",") if t.strip()}
        elif arg == "--allow-identity":
            value = argv[i + 1] if i + 1 < len(argv) else ""
            allowed_identity |= {t.strip().lower()
                                 for t in value.split(",") if t.strip()}
            skip_next = True
        elif not arg.startswith("--"):
            args.append(arg)
    if not args:
        print("usage: brain template <destination-dir> [--force] "
              "[--allow-identity <word,word>]")
        return 2
    dest = Path(args[0]).expanduser().resolve()
    # Refuse BEFORE destroying anything. This check used to run AFTER --force's
    # rmtree, which made it decoration: `brain template ~/brain --force` deleted
    # the brain and then printed the refusal. It also only looked upwards, so a
    # destination INSIDE the repo (`brain template knowledge --force`) was never
    # refused at all — the most destructive spelling of the same mistake. Both
    # directions of overlap are fatal: an ancestor is what --force would delete,
    # and a descendant would have the copy walking into its own output.
    if dest == ROOT or dest in ROOT.parents or ROOT in dest.parents:
        print(f"refusing to write the template over this repo: {dest} overlaps "
              f"{ROOT} — choose a destination outside it")
        return 1
    if dest.exists() and any(dest.iterdir()):
        if "--force" not in argv:
            print(f"{dest} exists and is not empty — refusing to overwrite. "
                  "Pass --force to replace its contents.")
            return 1
        shutil.rmtree(dest)

    skip_dirs = {".git", ".cache", "__pycache__", "node_modules", "graphify-out"}

    # Publish what git TRACKS, never what merely sits in the directory. Walking
    # the filesystem shipped anything lying around untracked — a .env with a
    # live key, a scratch file, a whole private/ folder someone had gitignored
    # precisely because it must not travel. The publish command cannot claim to
    # prove nothing private ships while its very first step is "copy
    # everything". Tracked-ness is the one signal that already means "this is
    # part of the project", and .gitignore is where people ALREADY record what
    # is machine-local, so this reuses a decision the publisher has made rather
    # than asking them to make it twice.
    tracked = git("ls-files", "-z")
    if tracked:
        candidates = [ROOT / rel for rel in tracked.split("\0") if rel]
    elif (ROOT / ".git").exists():
        print("refusing to publish: `git ls-files` returned nothing in a git "
              "repo — cannot tell your files from your leftovers")
        return 1
    else:
        # Not a git checkout at all (a tarball, a copy). Fall back to the walk,
        # but say so: the .gitignore-shaped safety net is simply not there.
        print("  [!] not a git repo — publishing by directory walk; anything "
              "untracked or gitignored in this tree WILL ship. Check it.")
        candidates = sorted(ROOT.rglob("*"))

    copied = 0
    for src in candidates:
        if not src.is_file() or src.is_symlink():
            continue
        rel = src.relative_to(ROOT)
        if set(rel.parts) & skip_dirs:
            continue
        if src.name == ".DS_Store" or src.name.endswith(".local.md"):
            continue
        if str(rel) in TEMPLATE_DROP:
            continue
        # knowledge/ ships as an empty skeleton: structure and vocabulary, no
        # notes. Compare against the path RELATIVE TO knowledge/, which is how
        # TEMPLATE_KEEP_KNOWLEDGE is written.
        if rel.parts[0] == "knowledge":
            in_knowledge = str(Path(*rel.parts[1:])) if len(rel.parts) > 1 else ""
            if in_knowledge not in TEMPLATE_KEEP_KNOWLEDGE and src.name != ".gitkeep":
                continue
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, target)
        copied += 1
    print(f"  [1/4] copied {copied} file(s): toolbelt, hooks, CI, tests, docs")

    # Keep every canonical folder present so a fresh brain has somewhere to put
    # its first note, and git actually tracks the empty directories.
    skeleton = list(CANONICAL) + ["inbox", "journal", "archive", "vault", "attachments"]
    for folder in skeleton:
        d = dest / "knowledge" / folder
        d.mkdir(parents=True, exist_ok=True)
        keep = d / ".gitkeep"
        if not any(d.iterdir()):
            keep.write_text("", encoding="utf-8")
    # The route map ships, but its hub list describes THIS brain — and every
    # [[link]] in it would dangle in an empty one, which lint rightly rejects.
    route_map = dest / "knowledge" / "index.md"
    if route_map.exists():
        text = route_map.read_text(encoding="utf-8")
        head = text.split("## Topic hubs")[0].rstrip()
        route_map.write_text(
            head + "\n\n## Topic hubs\n\n"
            "Link your hub pages here as you create them, so this stays a "
            "one-hop route\nmap to everything else:\n\n"
            "- (none yet — `bin/brain new topic \"...\" --topics ...` creates the "
            "first one)\n", encoding="utf-8")
    # The vocabulary is knowledge too. topics.yaml is kept out of the note sweep
    # above because a brain with no topics cannot lint, but shipping it verbatim
    # hands a stranger the author's private subject list — the names of their
    # projects, clients and concerns — in a file nobody thinks of as a note.
    topics_file = dest / "knowledge" / "topics.yaml"
    if topics_file.exists():
        topics_file.write_text(TEMPLATE_TOPICS, encoding="utf-8")

    # gate.yml's daily "pulse" job fails, and so emails the owner, if no commit
    # has reached GitHub in three days — a real backup alarm for a LIVE brain.
    # On the template repo itself, which by definition nobody commits to, it
    # would just email a red build every day after publish. Strip the schedule
    # trigger (and the pulse job it drives) from the template's OWN copy; the
    # push-triggered lint/tests stay, and SETUP documents re-enabling the pulse.
    gate = dest / ".github" / "workflows" / "gate.yml"
    if gate.exists():
        lines, kept, dropped = gate.read_text(encoding="utf-8").splitlines(), [], 0
        i = 0
        while i < len(lines):
            line = lines[i]
            stripped = line.strip()
            # Drop the `schedule:` block under `on:` and the whole `pulse:` job,
            # each by indentation: everything more-indented than the key belongs
            # to it. This keeps the edit structural rather than line-number bound.
            if stripped in ("schedule:", "pulse:") or stripped.startswith("pulse:"):
                indent = len(line) - len(line.lstrip())
                i += 1
                while i < len(lines) and (not lines[i].strip()
                                          or len(lines[i]) - len(lines[i].lstrip()) > indent):
                    i += 1
                dropped += 1
                continue
            kept.append(line)
            i += 1
        if dropped:
            header = (
                "name: gate\n"
                "# Content gate: on every push, re-run lint + gitleaks + tests\n"
                "# server-side, so nothing that slipped past a local hook lands\n"
                "# unnoticed.\n"
                "#\n"
                "# A daily dead-man 'pulse' job — fail, and so email you, if no\n"
                "# commit reaches GitHub in 3 days — was REMOVED from this template\n"
                "# copy: on a repo nobody commits to it would just email a red build\n"
                "# every day. Re-enable it once this is your live brain; SETUP.md\n"
                '# ("Backup alarm") has the block to paste back.\n')
            rest = "\n".join(kept)
            rest = rest[rest.index("\non:"):] if "\non:" in rest else rest
            gate.write_text(header + rest.rstrip() + "\n", encoding="utf-8")

    # The one example note ships to prove what a good note looks like, so its
    # OWN references must not be broken in the copy a stranger reads. It cites a
    # decision that stays behind, and its dates are the author's — a review_by
    # that is already in the past would have doctor flag the example as overdue
    # on day one. Rewrite the Sources section to stand alone and re-stamp the
    # dates to the emit, so the example is exemplary rather than a puzzle.
    example = dest / "knowledge" / "reference" / "note-conventions.md"
    if example.exists():
        today = date.today()
        fm_update(example, {
            "created": today.isoformat(),
            "review_by": today.replace(year=today.year + 1).isoformat(),
        })
        body = example.read_text(encoding="utf-8")
        head, sep, _sources = body.partition("## Sources")
        if sep:
            example.write_text(
                head + "## Sources\n\n"
                "- The full protocol lives in `AGENTS.md` at the repo root — this "
                "note is\n  one worked example of what it asks for.\n",
                encoding="utf-8")

    # A shipped note may cite notes that stay behind. Those [[links]] would
    # dangle in the template — which lint rightly refuses — so demote any target
    # that is not itself shipped to plain text.
    shipped_ids = set()
    for path in (dest / "knowledge").rglob("*.md"):
        fm, _err = parse_frontmatter(path.read_text(encoding="utf-8", errors="replace"))
        if fm and isinstance(fm.get("id"), str):
            shipped_ids.add(fm["id"])
    for path in (dest / "knowledge").rglob("*.md"):
        text = path.read_text(encoding="utf-8", errors="replace")
        rewritten = text
        for target in extract_links(text):
            if target not in shipped_ids:
                rewritten = rewritten.replace(f"[[{target}]]", target)
        if rewritten != text:
            path.write_text(rewritten, encoding="utf-8")
    print(f"  [2/4] knowledge/ reset to a starter skeleton "
          f"({len(skeleton)} folders, index.md + topics.yaml + 1 example note)")

    # Prove it: no note bodies, no owner key, no machine-local wiring, no secrets.
    leaks = []
    identity = publisher_identity_tokens()
    # Fail LOUD, not open. If nothing identifying could be derived (no git name
    # or email, no remote, a generic home like /app), the identity pass has
    # nothing to match on — and printing "clean" below would imply it ran and
    # found nothing, when it simply did not run. Say so, so the publisher knows
    # to eyeball the tree themselves rather than trust a check that was a no-op.
    identity_note = None
    if not identity:
        identity_note = ("no publisher identity could be derived (set git "
                         "user.name/user.email or a real origin) — the identity "
                         "leak scan did NOT run; eyeball the tree for your own name")
    identity -= allowed_identity
    token_res = {t: re.compile(r"\b" + re.escape(t) + r"\b") for t in identity}
    identity_paths = publisher_identity_paths()
    # The publisher's handle inside a link to the project's OWN repository is
    # the install URL — the one place naming them is the entire point, and it
    # appears in the README, the setup guide, the installer and the plugin
    # launcher. Masking those URLs before the token scan keeps the check honest
    # everywhere else in the same file, which whole-file exemptions cannot do.
    own_repo_re = None
    _remote = git("remote", "get-url", "origin")
    _slug = github_repo_slug(_remote)
    if _slug:
        own_owner = _slug.split("/")[0].lower()
        # Match the OWNER/REPO shape itself, not just github.com URLs. The same
        # reference is spelled four ways across the docs — an https URL, a
        # raw.githubusercontent.com URL, an ssh remote, and the bare slug that
        # `/plugin marketplace add <owner>/<repo>` takes — and only masking one
        # of them means the other three still refuse to publish.
        own = re.escape(own_owner)
        own_repo_re = re.compile(
            rf"\b{own}/[\w.-]+"      # owner/repo, in a URL or a bare slug
            rf"|@{own}\b",           # plugin@marketplace, where the marketplace
            re.I)                    # is conventionally named for the owner
    for path in dest.rglob("*"):
        if not path.is_file() or set(path.relative_to(dest).parts) & skip_dirs:
            continue
        rel = str(path.relative_to(dest))
        if rel in TEMPLATE_IDENTITY_OK:
            continue
        try:
            lowered = path.read_text(encoding="utf-8", errors="replace").lower()
        except OSError:
            continue
        scan_text = own_repo_re.sub(" ", lowered) if own_repo_re else lowered
        for token in sorted(identity):
            # Word boundaries, not substrings: "mark" must not fire on
            # "markdown". See publisher_identity_tokens() for why.
            if token_res[token].search(scan_text):
                leaks.append(f"{rel}: contains {token!r} — the publisher's own "
                             "name, handle or email. If that is a coincidence, "
                             f"re-run with --allow-identity {token}")
        for abs_path in sorted(identity_paths):
            if abs_path.lower() in lowered:
                leaks.append(f"{rel}: contains the absolute path {abs_path!r} — "
                             "machine-local wiring that names the publisher")
    for path in dest.rglob("*"):
        if not path.is_file() or set(path.relative_to(dest).parts) & skip_dirs:
            continue
        rel = str(path.relative_to(dest))
        if rel in TEMPLATE_DROP:
            leaks.append(f"{rel} should not have shipped")
        try:
            text = path.read_text(encoding="utf-8-sig", errors="replace")
        except OSError:
            continue
        if secret_screen(text):
            probe: list = []
            scan_secrets(path, probe)
            for _p, msg in probe:
                leaks.append(f"{rel}: {msg}")
    notes_shipped = [str(p.relative_to(dest / "knowledge"))
                     for p in (dest / "knowledge").rglob("*.md")
                     if str(p.relative_to(dest / "knowledge")) not in TEMPLATE_KEEP_KNOWLEDGE]
    leaks += [f"knowledge/{n} is one of your notes — it must not ship" for n in notes_shipped]
    if leaks:
        print("  [3/4] REFUSING TO PUBLISH — the template is not clean:")
        for leak in leaks:
            print(f"        - {leak}")
        # Take the unclean copy away with us. Leaving it on disk is how a
        # refused emit still gets published: the tree looks finished, the
        # refusal has scrolled off, and `git init && push` does not re-check.
        # Nothing is lost — every leak is named above, and the source is intact.
        shutil.rmtree(dest, ignore_errors=True)
        print(f"        (the unclean copy at {dest} was removed)")
        return 1
    if identity_note:
        print(f"  [3/4] scanned for notes, keys and secrets ........ clean")
        print(f"        NOTE: {identity_note}")
    else:
        print("  [3/4] scanned for notes, keys, secrets and your identity  clean")
    if allowed_identity:
        print(f"        WAIVED by --allow-identity: "
              f"{', '.join(sorted(allowed_identity))} — these were NOT checked")

    check = subprocess.run([sys.executable, str(dest / "bin" / "brain"), "lint"],
                           cwd=dest, capture_output=True, text=True)
    if check.returncode != 0:
        print("  [4/4] LINT FAILED on the generated template:")
        print("\n".join("        " + l for l in check.stdout.splitlines()[-12:]))
        shutil.rmtree(dest, ignore_errors=True)
        print(f"        (the unpublishable copy at {dest} was removed)")
        return 1
    print("  [4/4] lint ...................................... clean")
    print(f"\ntemplate ready: {dest}")
    print("publish it with a FRESH history (never reuse this repo's):")
    print(f"  cd {dest} && git init && git add -A && git commit -m 'second brain template'")
    print("  gh repo create <name> --public --source . --push")
    print("  then mark it as a template repository in GitHub's settings")
    return 0


# What each named schedule actually runs, and when. Weekday follows
# osbackend's convention (1-7, Monday=1) so it can be handed straight to
# whichever backend osbackend.scheduler() returns; consolidate's Sunday
# 18:00 and doctor's daily 21:00 are what setup/schedules/*.plist.template
# used to encode. Per-platform naming (com.secondbrain.X on macOS, X.timer
# on Linux, the raw name in Windows Task Scheduler) is the backend's own
# concern now, not brain's — see bin/brainlib/osbackend.py.
SCHEDULES = {
    "doctor": {"argv_tail": ["doctor-notify"], "when": {"hour": 21, "minute": 0}},
    "consolidate": {"argv_tail": ["consolidate"],
                    "when": {"weekday": 7, "hour": 18, "minute": 0}},
}


def github_repo_slug(remote: str) -> str:
    """'<owner>/<repo>' if this remote is on github.com, else ''."""
    if not remote or "github.com" not in remote:
        return ""
    m = re.search(r"github\.com[/:]([^/]+)/(.+?)(?:\.git)?/?$", remote.strip())
    return f"{m.group(1)}/{m.group(2)}" if m else ""


def remote_visibility(remote: str) -> str:
    """'public', 'private', or 'unknown' for a GitHub remote.

    This is the one failure in the whole system with no undo. Every other
    mistake is a note you rewrite; a brain pushed to a PUBLIC repo is every
    private thought you ever recorded, world-readable, in a history that
    outlives the fix. It has to be checked, and it has to be checked without
    assuming `gh` is installed.

    The unauthenticated API is what makes that possible, and the question it
    answers is the exact one worth asking — not "is this repo marked private"
    but "can a stranger read it". A 200 without credentials means yes, anyone
    can. A 401/403/404 means no anonymous reader gets in, which is the property
    being protected regardless of how the repo is labelled. Only a network or
    parse failure is 'unknown', because a check that quietly says "fine" when
    it could not look is worse than no check at all.
    """
    import shutil
    slug = github_repo_slug(remote)
    if not slug:
        return "unknown"
    # `gh` first: it is authoritative, local, and needs no network guessing.
    if shutil.which("gh"):
        got = subprocess.run(["gh", "repo", "view", slug, "--json", "visibility",
                              "-q", ".visibility"],
                             capture_output=True, text=True, timeout=20)
        if got.returncode == 0 and got.stdout.strip():
            return got.stdout.strip().lower()
    try:
        import urllib.error
        import urllib.request
        req = urllib.request.Request(
            f"https://api.github.com/repos/{slug}",
            headers={"Accept": "application/vnd.github+json",
                     "User-Agent": "brain-doctor"})
        with urllib.request.urlopen(req, timeout=8) as response:
            if response.status == 200:
                return "public"
    except urllib.error.HTTPError as exc:
        # No anonymous reader gets in. GitHub deliberately returns 404 rather
        # than 403 for a repo you may not see, so this cannot tell "private"
        # from "misspelled" — but both mean the notes are not world-readable,
        # which is the whole question.
        if exc.code in (401, 403, 404):
            return "private"
    except Exception:
        return "unknown"
    return "unknown"


def schedule_serves_this_repo(name: str) -> bool:
    """Is the installed `name` schedule THIS brain's, or a different one's?

    A schedule's identifier (a launchd label, a systemd unit name, a Task
    Scheduler task name) is machine-global, so merely finding it installed
    proves nothing — a brain that has been moved, renamed, or is simply the
    second one on this machine would see another brain's job and report
    itself scheduled. That is the worst kind of green: consolidation is the
    only thing that drains the inbox, so a false 'scheduled' means the inbox
    grows forever and the one check that would have said so is the check that
    lied. osbackend.scheduler() picks whichever backend this platform
    actually uses, so this same check is accurate on macOS, Linux and
    Windows rather than only where PLIST_DIR happens to mean something.
    """
    return osbackend.scheduler().serves(name, str(ROOT))
# There was a `remove_legacy_schedules()` here that unloaded two launchd jobs
# named after the author, left over from before this system was generalised.
# Exactly one machine on earth ever had them, they are gone from it, and this
# repo is about to be published — so the whole mechanism is deleted rather than
# scrubbed at emit time. A name in dead cleanup code is still a name in
# published source, and a scrub whose search pattern lives in the same file it
# rewrites is a trap for whoever edits that line next.


PLUGIN_SKILL = ROOT / "plugins" / "brain" / "skills" / "brain" / "SKILL.md"
SKILL_TEMPLATE = ROOT / "setup" / "skills" / "brain" / "SKILL.md.template"
# What {{REPO}} becomes in the PLUGIN copy. A plugin is installed once and used
# against whatever brain the user configured, so there is no absolute path to
# bake in — unlike the symlinked copy `init` renders, which belongs to exactly
# one clone and can name it.
PLUGIN_REPO_REF = ("the repository configured as this plugin's `brain_path` "
                   "(run `/plugin configure brain` to see or change it)")


def render_plugin_skill() -> str:
    return read_text(SKILL_TEMPLATE).replace("{{REPO}}", PLUGIN_REPO_REF)


def cmd_plugin(argv: list) -> int:
    """Keep the Claude Code plugin's skill identical to the one `init` renders.

    Two copies of the same instructions is the failure this project refuses
    everywhere else: they drift, and the one you are not looking at is the one
    that is wrong. So the plugin's SKILL.md is GENERATED from the same template
    `init` uses, never hand-edited, and `--check` makes drift a test failure
    rather than something noticed months later.
    """
    action = argv[0] if argv else "sync"
    if action not in ("sync", "check") and "--check" not in argv:
        print("usage: brain plugin sync [--check]")
        return 2
    wanted = render_plugin_skill()
    current = read_text(PLUGIN_SKILL) if PLUGIN_SKILL.exists() else ""
    if "--check" in argv or action == "check":
        if current == wanted:
            print("plugin skill is in sync with setup/skills/brain/SKILL.md.template")
            return 0
        print("plugin skill has DRIFTED from setup/skills/brain/SKILL.md.template — "
              "run: bin/brain plugin sync")
        return 1
    PLUGIN_SKILL.parent.mkdir(parents=True, exist_ok=True)
    PLUGIN_SKILL.write_text(wanted, encoding="utf-8")
    print(f"wrote {PLUGIN_SKILL.relative_to(ROOT)} from the shared template")
    return 0


def cmd_schedule(argv: list) -> int:
    """install|uninstall|status, entirely delegated to osbackend.scheduler().

    bin/brain used to render a plist from setup/schedules/*.plist.template and
    call `launchctl` directly, which is the whole reason this command only
    ever worked on macOS. Now it just supplies POLICY — which subcommand each
    named schedule runs, and on what cadence (SCHEDULES above) — and the
    platform-specific MECHANISM of expressing and installing that lives in
    the backend, so this same function works on Linux and Windows too.
    """
    action = argv[0] if argv else "status"
    backend = osbackend.scheduler()
    if action == "status":
        for name in SCHEDULES:
            if backend.status(name) != "installed":
                print(f"  {name}: not installed")
            elif schedule_serves_this_repo(name):
                print(f"  {name}: installed")
            else:
                print(f"  {name}: installed, but for a DIFFERENT brain — "
                      f"re-run 'bin/brain schedule install' from here to claim it")
        return 0
    if action not in ("install", "uninstall"):
        print("usage: brain schedule install [--with-consolidate] | uninstall | status")
        return 2
    targets = ["doctor"]
    if "--with-consolidate" in argv:
        targets.append("consolidate")
    if action == "uninstall":
        targets = list(SCHEDULES)
    # launchd agents and systemd --user units both start with almost no
    # environment, so without an explicit PATH a nightly job cannot see
    # Homebrew-installed gitleaks/age and reports them permanently "not
    # installed" — this is the one thing setup/schedules/*.plist.template
    # existed to carry, and the backend is now the only place that needs it.
    job_env = {"PATH": f"{Path.home()}/.local/bin:/opt/homebrew/bin:"
                       "/usr/local/bin:/usr/bin:/bin"}
    for name in targets:
        if action == "uninstall":
            backend.uninstall(name)
            print(f"removed schedule: {name}")
            continue
        spec = SCHEDULES[name]
        job_argv = [sys.executable, str(ROOT / "bin" / "brain")] + spec["argv_tail"]
        outcome = backend.install(name, job_argv, spec["when"], cwd=str(ROOT),
                                  env=job_env,
                                  log=str(ROOT / ".cache" / f"{name}-launchd.log"))
        if outcome.startswith("installed ("):
            # The backend's sentence already names exactly where it wrote the
            # job — splice the schedule name into that same sentence rather
            # than re-deriving the path here too, which would put the path in
            # two places able to drift apart.
            print(f"installed schedule: {name} {outcome[len('installed '):]}")
        else:
            print(f"schedule '{name}' not installed — {outcome}")
    return 0


def reset_blockers() -> list:
    """Every reason this brain is not safe to retire yet.

    Harder than doctor by design, and deliberately without an override flag.
    doctor answers "is this healthy"; this answers "is every byte of this
    recoverable from somewhere that is not this directory" — and the only
    honest answer to that is a fetch and a comparison, not a cached one.
    """
    blockers = []
    remote = git("remote", "get-url", "origin")
    if not remote:
        return ["no git remote — nothing to fall back to. Everything here exists "
                "on this machine only, so there is no fresh start, only a loss."]
    if is_local_remote(remote):
        return [f"the remote is a path on this machine ({remote}) — it is a copy, "
                "not a backup. Retiring this brain would leave both halves on one "
                "disk."]

    # Fetch FIRST. doctor's checks compare against whatever was last fetched,
    # which on an unattended machine can be days old — and "already pushed" read
    # from a stale ref is the one wrong answer that costs everything.
    fetched = subprocess.run(["git", "fetch", "origin", "--prune"], cwd=ROOT,
                             capture_output=True, text=True, timeout=180)
    if fetched.returncode != 0:
        return [f"could not reach the remote: "
                f"{(fetched.stderr or '').strip()[-200:] or 'git fetch failed'}. "
                "Unverifiable is not the same as backed up."]

    if git("status", "--porcelain").strip():
        blockers.append("the working tree is not clean — commit or discard first")
    if git("stash", "list").strip():
        blockers.append("git stash is not empty — a stash lives in .git and would go "
                        "with it (the bundle keeps it, but you would have to know to look)")
    # A detached HEAD can sit on a commit that no branch points at, which the
    # per-branch loop below never inspects and `git push` never sent. Refuse it
    # outright rather than reason about whether that commit is backed up.
    if git("symbolic-ref", "--quiet", "HEAD") == "" and \
            git("rev-parse", "--abbrev-ref", "HEAD") == "HEAD":
        blockers.append("HEAD is detached — check out a branch first, so every commit "
                        "you are on is on a ref that gets pushed and bundled")

    # Every branch, not just this one. A branch left behind on a laptop is
    # exactly the kind of thing a fresh start is supposed to not silently eat.
    for line in git("for-each-ref", "--format=%(refname:short) %(upstream:short)",
                    "refs/heads").splitlines():
        parts = line.split()
        branch = parts[0]
        upstream = parts[1] if len(parts) > 1 else ""
        if not upstream:
            blockers.append(f"branch {branch!r} has no upstream — it exists only here")
            continue
        # Check the exit code, not just the output. If the upstream ref was
        # deleted or pruned on the remote (the --prune above removes the local
        # tracking ref while branch.<name>.merge still names it), rev-list ERRORS
        # on a bad revision. The plain git() helper swallows that as "", which
        # `ahead and ahead != "0"` reads as zero-ahead — a false "all pushed"
        # all-clear for a branch whose backup can no longer be verified at all.
        counted = subprocess.run(["git", "rev-list", "--count", f"{upstream}..{branch}"],
                                 cwd=ROOT, capture_output=True, text=True)
        if counted.returncode != 0:
            blockers.append(f"branch {branch!r} tracks {upstream!r}, which no longer "
                            "exists on the remote — its backup cannot be verified. Push "
                            "it to a live branch or delete it deliberately.")
            continue
        ahead = counted.stdout.strip()
        if ahead and ahead != "0":
            blockers.append(f"branch {branch!r} has {ahead} unpushed commit(s)")

    unreviewed = [b.strip().lstrip("* ") for b in
                  git("branch", "--no-merged", default_branch(), "--list", "consolidate/*").splitlines()
                  if b.strip()]
    unreviewed += [b.strip() for b in
                   git("branch", "-r", "--no-merged", default_branch(), "--list",
                       "origin/consolidate/*").splitlines() if b.strip()]
    if unreviewed:
        blockers.append("unreviewed consolidation branch(es): "
                        + ", ".join(sorted(set(unreviewed)))
                        + " — machine-written knowledge nobody has read yet. Merge or "
                          "delete them deliberately first.")
    return blockers


def reset_phrase() -> str:
    """The sentence the owner must type, computed from live state.

    Both halves are load-bearing. The COUNT makes a stale phrase — pasted from
    a chat, a runbook, or a previous attempt — refuse, because it stops matching
    the moment the brain changes. The REMOTE says out loud where the history is
    going to keep living, so nobody types this believing it destroys their notes.
    """
    canonical = sum(1 for folder in CANONICAL for _ in (K / folder).rglob("*.md"))
    # Shortened to the part a person recognises — scheme, credentials and the
    # .git suffix carry no meaning here and make the line harder to type
    # correctly. Colons are left alone: they separate host from path in
    # scp-style remotes and host from port in git://, and rewriting either
    # produced a string that named no real repository.
    remote = git("remote", "get-url", "origin") or "no remote"
    remote = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", "", remote)
    remote = re.sub(r"^[^@/]+@", "", remote)
    remote = re.sub(r"\.git$", "", remote)
    # Shortened on 2026-07-29 from "history stays at": the WHAT IS KEPT block
    # now states where the history lives, in full, two lines above this prompt.
    # Saying it twice made the one line somebody has to type by hand longer for
    # no information, and length here is friction without safety — the count is
    # what makes a pasted phrase refuse.
    return f"retire {canonical} notes, keep {remote}"


def reset_dewire() -> tuple:
    """Undo this clone's machine-local wiring. Returns (done, preserved).

    Every step checks OWNERSHIP before touching anything. The global skill
    symlink in particular is shared machine state: during the research for this
    command it was found pointing at a scratch checkout, because `brain init`
    had been run from one. A reset that unlinks whatever it finds would
    silently disconnect a DIFFERENT brain — so a link that does not resolve
    into this clone is reported and left exactly where it is.
    """
    import shutil
    done, preserved = [], []

    if cmd_schedule(["uninstall"]) == 0:
        done.append("launchd jobs unloaded (doctor, consolidate)")

    link = Path.home() / ".claude" / "skills" / "brain"
    if link.is_symlink():
        try:
            target = link.resolve()
        except OSError:
            target = None
        # Both sides resolved before comparing. link.resolve() follows symlinks,
        # so an unresolved ROOT (/var/... vs /private/var/... on macOS) would
        # never match its own clone and every link would be reported foreign —
        # failing safe, but wrong, and wrong in a way nobody would investigate.
        here = ROOT.resolve()
        if target is not None and (target == here or here in target.parents):
            link.unlink()
            done.append(f"unlinked {link}")
        else:
            preserved.append(f"{link} — points at {target}, NOT this clone. Left "
                             "alone: it belongs to another brain.")
    elif link.exists():
        preserved.append(f"{link} exists and is not a symlink — left alone")

    # The routing block, now that `connect --apply` writes it between markers.
    # A block left behind points every future session at a directory that is no
    # longer there — which is exactly the state every machine that ever ran the
    # old paste-it-yourself instructions is still in.
    from brainlib import configedit
    for key in CONNECT_CLIENTS:
        _, routing = client_paths(key)
        if routing is None or not routing.is_file():
            continue
        text = read_text(routing)
        if configedit.MARKER_START in text:
            if configedit.remove_markers(routing).changed:
                done.append(f"routing block removed from {routing}")
        elif str(ROOT) in text:
            # Written by hand, before markers existed. Deleting text this
            # system cannot prove it wrote is the one thing worse than leaving
            # it behind, so it is named and left.
            preserved.append(f"{routing} mentions this brain but carries no markers "
                             "— it was written by hand, so this cannot prove which "
                             "lines are its own. Remove them yourself.")

    if shutil.which("claude"):
        got = subprocess.run(["claude", "mcp", "get", "brain"], cwd=ROOT,
                             capture_output=True, text=True, timeout=60)
        registered = str(ROOT / "bin" / "brain-mcp") in got.stdout
        if registered:
            removed = subprocess.run(["claude", "mcp", "remove", "brain", "-s", "user"],
                                     cwd=ROOT, capture_output=True, text=True, timeout=60)
            if removed.returncode == 0:
                done.append("MCP server 'brain' removed from user scope")
            else:
                preserved.append("MCP registration could not be removed — run: "
                                 "claude mcp remove brain -s user")
        elif got.stdout.strip():
            preserved.append("MCP server 'brain' is registered to a DIFFERENT path — "
                             "left alone")
    return done, preserved


def preserved_report(remote_url: str, retired: Path, bundle: Path) -> list:
    """What reset deliberately left alone, as plain strings.

    A pure function of its arguments, and it has to be: it runs AFTER the repo
    has been moved aside, when ROOT no longer exists and any git call from
    cwd=ROOT raises. The first real end-to-end run crashed here with a traceback
    at the exact moment the operator most needs to be told nothing was lost.
    """
    return [
        f"the remote itself. Every note and every commit is still at "
        f"{remote_url or 'the origin'}, and this command has no ability to change "
        "that. Renaming or archiving it is yours to do.",
        f"{retired} — the whole old brain, intact. Delete it by hand, later, once "
        "the new one has passed doctor.",
        f"{bundle} — a second, independent copy of all history.",
        "~/.config/brain/vault-key.txt and the Keychain item 'brain-vault-key'. "
        "The key IS the vault; nothing in this system ever touches either.",
        "this project's trust flag, which is keyed to the path — so a fresh clone "
        "at the same path inherits it. That is intended, not a leftover. (The "
        "routing block itself is NOT preserved: since 2026-07-29 it is written "
        "between markers and this command takes it back out. A block written by "
        "hand before that has no markers, and is named and left alone rather than "
        "guessed at.)",
        "agent transcripts (e.g. ~/.claude/projects/…). Old note text lingers "
        "there. Clearing it is your call, not this tool's.",
    ]


def retire_plan(remote_url: str, retired: Path, bundle: Path) -> tuple:
    """(what happens, what is kept) — a pure function of its arguments.

    Pure so that `--dry-run` and a real run cannot describe different things:
    there is one description and both print it. A preview written separately
    from the act is a preview that can be wrong exactly where it matters.

    Plain language, with the internal name in brackets. Somebody about to
    retire their brain should not have to know what launchd is to understand
    what is about to stop.
    """
    happens = [
        f"{ROOT} is MOVED aside to {retired}. Nothing is deleted, by this "
        "command or any other.",
        f"a second, independent copy of ALL history is written to {bundle}, "
        "and verified before anything moves.",
        "this machine is unwired: the weekly background jobs are stopped "
        f"({osbackend.scheduler().kind}), the /brain skill link is removed, the "
        "MCP registration is removed, and the routing block is taken back out "
        "of your agents' instruction files.",
    ]
    kept = [
        f"your remote. Every note and every commit stays at "
        f"{remote_url or 'the origin'}, and this command cannot touch it.",
        f"{retired} — the whole old brain, intact, until you delete it by hand.",
        "your vault key, your agents' transcripts, and four other things: "
        "brain retire --explain",
    ]
    return happens, kept


def cmd_retire(argv: list, alias: bool = False) -> int:
    """Retire this brain and start clean — the only destructive command here.

    Deliberately the only interactive one, and deliberately absent from
    bin/brain-mcp's tool list, which is a whitelist: omission is enough. The
    TTY test is the belt to that braces — an agent that shells out to
    `bin/brain reset` gets a refusal rather than a wipe, because a subprocess
    has no terminal.

    Nothing here deletes anything. The repo is MOVED aside and a verified
    bundle is written outside it; the remote is never touched at all. Deleting
    is a later, manual act by a person who has already seen the new brain work.
    """
    import shutil

    if alias:
        print("brain reset is now `brain retire`. Same command, clearer name — "
              "the old\none keeps working because it is in shipped docs.\n")

    def block(title: str, lines: list) -> None:
        print(f"\n{title}")
        for line in lines:
            for i, wrapped in enumerate(textwrap.wrap(line, 72)):
                print(("  - " if i == 0 else "    ") + wrapped)

    if "--explain" in argv:
        # The six-paragraph preserved list, which used to print unconditionally
        # at the end of every run and buried the three facts that matter.
        stamp = "<timestamp>"
        block("KEPT, IN FULL",
              preserved_report(git("remote", "get-url", "origin"),
                               Path(str(ROOT) + f".retired-{stamp}"),
                               Path.home() / f"brain-backup-{stamp}.bundle"))
        print("\nNothing was changed. To see the plan for this brain: "
              "brain retire --dry-run")
        return 0

    dry_run = "--dry-run" in argv
    # --dry-run is allowed without a terminal on purpose. It writes nothing, so
    # the refusal below would only stop people — and agents asked "what would
    # this do" — from finding out what the command does before running it.
    if not dry_run and not sys.stdin.isatty():
        print("brain retire is interactive and refuses to run without a terminal.")
        print("If you are an agent: this command is not yours to run. It is not in "
              "the MCP tool list, and it will not accept a piped confirmation.")
        print("What it would do, safely: bin/brain retire --dry-run")
        return 1

    print("brain retire — retire this brain and start clean")

    # Read BEFORE anything moves. Every git call runs with cwd=ROOT, so once the
    # repo is aside there is no asking git anything.
    remote_url = git("remote", "get-url", "origin")
    stamp = time.strftime("%Y-%m-%d-%H%M%S")
    retired = Path(str(ROOT) + f".retired-{stamp}")
    bundle = Path.home() / f"brain-backup-{stamp}.bundle"
    happens, kept = retire_plan(remote_url, retired, bundle)
    block("WHAT HAPPENS", happens)
    block("WHAT IS KEPT", kept)

    print("\nChecking that nothing here exists only here…")
    blockers = reset_blockers()
    if blockers:
        print("\nREFUSING — this brain is not fully backed up:\n")
        for blocker in blockers:
            for i, line in enumerate(textwrap.wrap(blocker, 72)):
                print(("  - " if i == 0 else "    ") + line)
        print("\nThere is no --force for this. Fix the above and run it again.")
        print("Nothing was changed.")
        return 1
    print("  [ok ] every commit on every branch is on the remote")

    if dry_run:
        # Stops here, after every safety check has actually run. A dry run that
        # skipped the checks would be a plan for a brain other than this one.
        print("\nThat is the whole plan, and nothing was changed. Run it for real "
              "with:\n  bin/brain retire")
        return 0

    # --all AND HEAD: --all bundles refs/heads, tags and remotes, but a commit
    # reachable only from a detached HEAD sits on no ref and would be left out
    # of a bundle that claims to hold all history. Naming HEAD closes that gap;
    # reset_blockers already refuses a detached HEAD, so this is belt-and-braces.
    made = subprocess.run(["git", "bundle", "create", str(bundle), "--all", "HEAD"],
                          cwd=ROOT, capture_output=True, text=True, timeout=600)
    if made.returncode != 0 or not bundle.exists():
        print(f"\nABORTED — could not write the backup bundle: "
              f"{(made.stderr or '').strip()[-300:] or 'git bundle failed'}")
        return 1
    verified = subprocess.run(["git", "bundle", "verify", str(bundle)],
                              cwd=ROOT, capture_output=True, text=True, timeout=600)
    if verified.returncode != 0:
        print(f"\nABORTED — the backup bundle did not verify: "
              f"{(verified.stderr or '').strip()[-300:] or 'git bundle verify failed'}")
        print(f"The unusable bundle is at {bundle} — inspect it, do not trust it.")
        return 1
    size = bundle.stat().st_size
    print(f"  [ok ] bundle written and verified: {bundle} ({size // 1024} KB)")

    phrase = reset_phrase()
    print("\nTo confirm, type this line exactly:\n")
    print(f"    {phrase}\n")
    try:
        typed = input("> ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\ncancelled — nothing was changed")
        return 1
    if typed != phrase:
        print("\nthat is not the phrase — nothing was changed")
        print("(it is computed from this brain's live note count and remote, so a "
              "phrase copied from anywhere else will not match)")
        return 1

    print("\nDe-wiring this machine…")
    done, preserved = reset_dewire()
    for line in done:
        print(f"  [done] {line}")

    try:
        ROOT.replace(retired)
    except OSError as exc:
        print(f"\nABORTED — could not move the repo aside: {exc}")
        print("The de-wiring above already happened; re-run `bin/brain init` to undo it.")
        return 1
    print(f"  [done] {ROOT} → {retired}")

    # Only what this run found and deliberately left alone — a foreign skill
    # link, an MCP entry pointing elsewhere, a hand-written routing block. The
    # standing six-item list moved behind --explain: printed every time, it
    # buried the two or three findings that were actually about this machine.
    if preserved:
        block("LEFT ALONE — found here and deliberately not touched", preserved)
    block("KEPT", retire_plan(remote_url, retired, bundle)[1])

    print("\nNext: install a fresh brain, exactly as a stranger would.")
    print("\n  curl -fsSL https://raw.githubusercontent.com/Cazy00/brain/main/"
          "install.sh | sh")
    print("\nNothing above needs undoing first. The full list of what was kept: "
          f"\n  {retired}/bin/brain retire --explain")
    return 0


def note_birthdays() -> dict:
    """rel-path -> ISO date the note first entered git history.

    File mtime is not age. Every clone, checkout and `git pull` stamps mtime to
    now, so on a second machine a three-year-old note and one written this
    morning are indistinguishable — and any signal built on mtime (how stale is
    the inbox, is capture still happening) silently resets to "all healthy" the
    moment you clone. Git is the only record of when something actually
    arrived, and it survives being copied.

    One `git log` for the whole tree rather than one per file: per-file is
    correct too, and unusably slow past a few hundred notes.
    """
    out = git("log", "--diff-filter=A", "--name-only", "--format=%x00%aI",
              "--", "knowledge")
    birthdays, current = {}, None
    for line in out.splitlines():
        if line.startswith("\0"):
            current = line[1:].strip()[:10]
        elif line.strip() and current:
            # Newest-first, so later sightings are EARLIER adds: keep overwriting
            # and the oldest wins.
            birthdays[line.strip()] = current
    return birthdays


def stats_snapshot() -> dict:
    """Every deterministic health signal this system can produce, as data.

    Deliberately model-free. The question "is my brain still trustworthy" has
    to be answerable at 3am by a cron job with no API key, and anything that
    needs a model to decide is a thing that will silently stop being checked.
    """
    import sqlite3
    today = date.today()
    birthdays = note_birthdays()

    def days_since(iso):
        try:
            return (today - date.fromisoformat(iso)).days
        except (TypeError, ValueError):
            return None

    corpus, aliasless, no_review, ids, id_of_path = {}, [], [], set(), {}
    all_notes = []
    for path in sorted(K.rglob("*.md")):
        rel = str(path.relative_to(ROOT))
        parts = path.relative_to(K).parts
        top = parts[0] if parts else ""
        if top in ("archive", "vault"):
            continue
        fm, _err = parse_frontmatter(read_text(path))
        if not fm:
            continue
        note = {"rel": rel, "top": top, "id": fm.get("id"),
                "title": fm.get("title") or "", "aliases": fm.get("aliases") or [],
                "review_by": fm.get("review_by"),
                "born": birthdays.get(rel)}
        all_notes.append(note)
        corpus[top] = corpus.get(top, 0) + 1
        if fm.get("id"):
            ids.add(fm["id"])
            id_of_path[rel] = fm["id"]
        if top in CANONICAL:
            if not note["aliases"]:
                aliasless.append(note["id"] or rel)
            if not fm.get("review_by"):
                no_review.append(note["id"] or rel)

    canonical_notes = [n for n in all_notes if n["top"] in CANONICAL]

    # Findability. The failure this catches is the quiet one: a note that
    # exists, is correct, and is never returned — so the brain "has" the answer
    # and still cannot produce it. Searching a note's own title is the weakest
    # possible query that must work; if that misses, nothing a human types will
    # do better.
    unfindable = []
    for note in canonical_notes:
        if not note["title"] or not note["id"]:
            continue
        try:
            hits = do_search(note["title"], scope="canonical", limit=5)["hits"]
        except Exception:
            continue
        if note["id"] not in [h.get("id") for h in hits]:
            unfindable.append({"id": note["id"], "title": note["title"]})

    # Link graph. An orphan is not wrong, but a note nothing points at and that
    # points nowhere is only ever found by exact wording — it has left the graph
    # that makes "everything about X" work.
    inbound = {i: 0 for i in ids}
    outbound = {}
    for note in all_notes:
        links = extract_links(read_text(ROOT / note["rel"]))
        outbound[note["id"]] = len([l for l in links if l in ids])
        for target in links:
            if target in inbound:
                inbound[target] += 1
    orphans = [n["id"] for n in canonical_notes
               if n["id"] and not inbound.get(n["id"]) and not outbound.get(n["id"])]

    # Capture rate. "inbox empty" is ambiguous in the worst way: it reads as
    # healthy, and it is also exactly what a brain that has silently STOPPED
    # being written to looks like. Only the trend tells them apart.
    def added_within(days):
        return sum(1 for rel, born in birthdays.items()
                   if (days_since(born) is not None and days_since(born) <= days))

    inbox_items = sorted(
        (rel for rel in birthdays
         if rel.startswith("knowledge/inbox/") and rel.endswith(".md")
         and (ROOT / rel).exists()),
        key=lambda r: birthdays[r])
    oldest_inbox = days_since(birthdays[inbox_items[0]]) if inbox_items else 0

    overdue = [n["id"] for n in canonical_notes
               if n["review_by"] and (days_since(n["review_by"]) or -1) > 0]

    unreviewed = [b.strip() for b in
                  git("branch", "--no-merged", default_branch(),
                      "--list", "consolidate/*").splitlines() if b.strip()]
    last_consolidation = git("log", "-1", "--format=%aI", "--all",
                             "--grep=^consolidate", "--regexp-ignore-case")[:10]

    return {
        "generated": today.isoformat(),
        "corpus": corpus,
        "total_current": len(canonical_notes),
        "capture": {
            "added_7d": added_within(7),
            "added_30d": added_within(30),
            "added_90d": added_within(90),
            "inbox_waiting": len(inbox_items),
            "inbox_oldest_days": oldest_inbox,
        },
        "findability": {
            "checked": len([n for n in canonical_notes if n["title"] and n["id"]]),
            "unfindable": unfindable,
            "aliasless": aliasless,
            "orphans": orphans,
        },
        "freshness": {
            "review_by_set": len(canonical_notes) - len(no_review),
            "review_by_missing": len(no_review),
            "overdue": overdue,
        },
        "consolidation": {
            "last_seen": last_consolidation or None,
            "unreviewed_branches": unreviewed,
        },
        "integrity": {
            "index_stale": index_stale(),
            "duplicate_ids": len(id_of_path) - len(set(id_of_path.values())),
        },
    }


def cmd_stats(argv: list) -> int:
    """Trend and trust signals — the answer to 'is this thing still working?'

    doctor answers "is the machinery wired up". This answers the harder
    question doctor cannot: is the knowledge itself still findable, still
    growing, still being curated. Those fail slowly and silently, which is
    exactly why they need a number rather than a vibe.
    """
    import json
    snap = stats_snapshot()
    if "--json" in argv:
        print(json.dumps(snap, indent=2))
        return 0

    cap, find = snap["capture"], snap["findability"]
    fresh, cons = snap["freshness"], snap["consolidation"]
    total = snap["total_current"]
    print("\nbrain stats\n")

    print(f"  corpus     {total} current note(s)")
    for folder in CANONICAL:
        if snap["corpus"].get(folder):
            print(f"             {snap['corpus'][folder]:>4}  {folder}")

    print(f"\n  capture    {cap['added_7d']} added in 7d, {cap['added_30d']} in 30d, "
          f"{cap['added_90d']} in 90d")
    if cap["added_30d"] == 0 and total:
        print("             [RED] nothing captured in 30 days — a brain stops being "
              "written to long before anyone notices. Is the routing block still "
              "in your agent's global instructions?")
    if cap["inbox_waiting"]:
        print(f"             {cap['inbox_waiting']} in inbox, oldest "
              f"{cap['inbox_oldest_days']}d")

    checked = find["checked"]
    missed = len(find["unfindable"])
    if checked:
        rate = 100 * (checked - missed) / checked
        state = "ok " if missed == 0 else "RED"
        print(f"\n  findable   [{state}] {checked - missed}/{checked} notes are "
              f"returned by a search for their own title ({rate:.0f}%)")
        for miss in find["unfindable"][:5]:
            print(f"             - {miss['id']}: searching {miss['title']!r} does "
                  "not return it")
        if missed > 5:
            print(f"             … and {missed - 5} more")
    if find["aliasless"]:
        print(f"             {len(find['aliasless'])} note(s) have no aliases — the "
              "cheapest retrieval lever there is")
    if find["orphans"]:
        print(f"             {len(find['orphans'])} note(s) are outside the link "
              "graph (nothing points at them, they point nowhere)")

    print(f"\n  freshness  {fresh['review_by_set']}/{total} carry a review_by date")
    if fresh["overdue"]:
        print(f"             [RED] {len(fresh['overdue'])} past their review date: "
              f"{', '.join(fresh['overdue'][:3])}")

    print(f"\n  curation   last consolidation: {cons['last_seen'] or 'never seen'}")
    if cons["unreviewed_branches"]:
        print(f"             [RED] {len(cons['unreviewed_branches'])} consolidate "
              "branch(es) awaiting review — knowledge written but not merged")

    if snap["integrity"]["duplicate_ids"]:
        print(f"\n  integrity  [RED] {snap['integrity']['duplicate_ids']} duplicate id(s)")

    if "--record" in argv:
        line = json.dumps({k: v for k, v in snap.items() if k != "findability"} |
                          {"findability": {"checked": checked, "unfindable": missed,
                                           "aliasless": len(find["aliasless"]),
                                           "orphans": len(find["orphans"])}},
                          sort_keys=True)
        history = ROOT / "knowledge" / ".health.jsonl"
        with history.open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
        print(f"\n  recorded to {history.relative_to(ROOT)} — commit it, and the trend "
              "survives a re-clone")
    print()
    return 0


def cmd_doctor_notify() -> int:
    run = subprocess.run([sys.executable, str(Path(__file__).resolve()), "doctor"],
                         capture_output=True, text=True, cwd=ROOT)
    report = run.stdout + run.stderr
    (ROOT / ".cache").mkdir(exist_ok=True)
    stamp = time.strftime("%Y-%m-%d %H:%M")
    (ROOT / ".cache" / "doctor-report.txt").write_text(f"{stamp}\n\n{report}", encoding="utf-8")
    if run.returncode != 0:
        subprocess.run(["osascript", "-e",
                        'display notification "red state — see .cache/doctor-report.txt" '
                        'with title "brain doctor"'], capture_output=True)
    return run.returncode


def cmd_doctor() -> int:
    print("brain doctor\n")
    ok = True

    hooks = git("config", "core.hooksPath") == ".githooks"
    if hooks:
        print("  [ok ] git hooks installed")
    else:
        # Must flip ok: with the commit gate off, secrets and malformed notes
        # commit freely. A RED line that still exits 0 means the scheduled
        # watchdog (which only notifies on non-zero exit) never fires.
        ok = False
        print("  [RED] git hooks not installed — run any bin/brain command to fix")

    remote = git("remote", "get-url", "origin")
    if remote and is_local_remote(remote):
        # A "remote" that is a directory on this machine is not a backup, and
        # post-commit deliberately refuses to push to it (cloning your brain to
        # experiment would otherwise push the experiments back into the real
        # one). Say so plainly rather than printing a reassuring [ok].
        ok = False
        print(f"  [RED] remote is a local path ({remote}) — this is NOT an "
              "off-machine backup, and auto-push is disabled for it. Set a real "
              "remote: git remote set-url origin <url>")
    elif remote:
        print(f"  [ok ] remote: {remote}")
        visibility = remote_visibility(remote)
        if visibility == "public":
            ok = False
            slug = github_repo_slug(remote)
            print("  [RED] YOUR BRAIN IS PUBLIC — anyone on the internet can read "
                  "every note in it.")
            print(f"         Fix it now:  gh repo edit {slug} --visibility private "
                  "--accept-visibility-change-consequences")
            print("         Then assume anything already pushed has been seen: "
                  "rotate any credential, and remember git history keeps what "
                  "you delete.")
        elif visibility == "private":
            print("  [ok ] remote is not publicly readable")
        else:
            print("  [-- ] could not check whether the remote is public "
                  "(offline, or not GitHub) — verify it yourself")
        has_upstream = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "@{u}"],
            cwd=ROOT, capture_output=True).returncode == 0
        if not has_upstream:
            ok = False
            print("  [RED] no upstream tracking — backup state unknown; run: "
                  "git push -u origin main")
        else:
            unpushed = git("rev-list", "--count", "@{u}..HEAD")
            if unpushed and unpushed != "0":
                ok = False
                print(f"  [RED] {unpushed} commit(s) not pushed — backup is behind; run: git push")
            else:
                print("  [ok ] all commits pushed to remote")
    else:
        ok = False
        print("  [RED] no git remote — knowledge is not backed up")

    dirty = [l for l in git("status", "--porcelain", "knowledge").splitlines() if l.strip()]
    if dirty:
        print(f"  [RED] {len(dirty)} uncommitted change(s) in knowledge/ — commit soon; "
              "uncommitted notes are unvetted and unbacked")
        ok = False
    else:
        print("  [ok ] knowledge/ fully committed")

    import shutil
    for tool, why in (("gitleaks", "second secret scanner at commit time"),
                      ("age", "vault encryption for sensitive notes")):
        if shutil.which(tool):
            print(f"  [ok ] {tool} installed")
        else:
            print(f"  [-- ] {tool} not installed ({why}) — brew install {tool}")

    if INDEX_DB.exists():
        print("  [-- ] search index is stale — refreshes automatically on next search"
              if index_stale() else "  [ok ] search index fresh")
    else:
        print("  [-- ] no search index yet — built automatically on first search")

    inbox_items = sorted((K / "inbox").glob("*.md"), key=lambda p: p.stat().st_mtime)
    if inbox_items:
        oldest_days = int((time.time() - inbox_items[0].stat().st_mtime) / 86400)
        state = "RED" if (len(inbox_items) > 25 or oldest_days > 21) else "ok "
        if state == "RED":
            ok = False
        print(f"  [{state}] inbox backlog: {len(inbox_items)} item(s), oldest {oldest_days}d — "
              "drain via bin/brain consolidate")
    else:
        print("  [ok ] inbox empty")

    # An empty inbox is ambiguous in the worst possible way: it is what a
    # healthy, freshly-drained brain looks like, and it is ALSO exactly what a
    # brain nobody is writing to any more looks like. The difference is only
    # visible as a rate, so it gets its own line. Silence is the failure mode —
    # the routing block gets dropped from a global instruction file, or an agent
    # update stops honouring it, and nothing anywhere says the brain stopped
    # growing until someone wonders why it never knows anything recent.
    _born = note_birthdays()
    _recent = sum(1 for _rel, _day in _born.items()
                  if _rel.endswith(".md") and (ROOT / _rel).exists()
                  and (date.today() - date.fromisoformat(_day)).days <= 30)
    if _born and not _recent:
        print("  [RED] nothing captured in 30 days — a brain stops being written "
              "to long before anyone notices. Check the routing block is still in "
              "your agent's global instructions (bin/brain connect --routing)")
        ok = False
    elif _born:
        print(f"  [ok ] {_recent} note(s) captured in the last 30 days")

    # The inbox only drains if consolidation actually runs. Worth its own line
    # because a missing consolidate job is otherwise invisible: every other
    # check stays green while captures pile up with nowhere to go.
    if schedule_serves_this_repo("consolidate"):
        print("  [ok ] weekly consolidation scheduled")
    elif osbackend.scheduler().status("consolidate") == "installed":
        print("  [RED] weekly consolidation is scheduled for a DIFFERENT brain — "
              "this one never drains; bin/brain schedule install --with-consolidate")
        ok = False
    else:
        print("  [-- ] weekly consolidation not scheduled — generous capture has no "
              "outlet; bin/brain schedule install --with-consolidate")

    # Project permissions only apply once the workspace is TRUSTED. Untrusted,
    # the allowlist is discarded with a warning nobody reads in a headless run,
    # and consolidation degrades quietly: the pass cannot invoke bin/brain, so
    # it hand-writes frontmatter instead of using the tool that guarantees the
    # note contract. Green everywhere else while the output gets worse.
    # Runner-conditional. The trust flag is a Claude Code concept: on a brain
    # consolidated by any other runner this check has nothing to say, and left
    # unconditional it would sit permanently RED on a correctly configured
    # machine — which is how a health check stops being read at all.
    try:
        _runner = load_consolidator()
        _runner_error = None
    except ConsolidatorConfigError as exc:
        _runner, _runner_error = None, str(exc)
    if _runner_error:
        ok = False
        print(f"  [RED] consolidation runner misconfigured — {_runner_error}")
    elif _runner["propose"][0] == "claude" and (ROOT / ".claude" / "settings.json").exists():
        trusted = False
        try:
            import json as _json
            config = _json.loads((Path.home() / ".claude.json").read_text(encoding="utf-8"))
            entry = (config.get("projects") or {}).get(str(ROOT)) or {}
            trusted = bool(entry.get("hasTrustDialogAccepted"))
        except (OSError, ValueError):
            pass
        if trusted:
            print("  [ok ] consolidation permissions active (workspace trusted)")
        elif schedule_serves_this_repo("consolidate"):
            ok = False
            print("  [RED] workspace NOT trusted — .claude/settings.json is ignored, so "
                  "consolidation cannot run bin/brain and will hand-write notes. Open "
                  "Claude Code here once and accept the trust prompt.")
        else:
            # Nothing is scheduled yet, so nothing is degraded yet. A brand-new
            # install would otherwise open on a RED line for a step the setup
            # guide has not reached — and a first health report that cries wolf
            # is how people learn to skip the health report.
            print("  [-- ] workspace not trusted yet — fine for now; accept the trust "
                  "prompt in Claude Code before scheduling consolidation")
    elif _runner:
        print(f"  [ok ] consolidation runner: {_runner['propose'][0]} "
              f"({_runner['model']}), auditor read-only")

    today_iso = date.today().isoformat()
    _meta = MetaIndex()
    try:
        overdue = _meta.overdue(today_iso)
    finally:
        _meta.close()
    if overdue:
        print(f"  [-- ] {len(overdue)} note(s) past review_by — verify them during consolidation")

    # Locator rot. Notes point at work that lives outside this repo (AGENTS.md
    # "Work that lives elsewhere"), and a local path is the perishable half of
    # every locator — true on this machine, meaningless on the next one.
    #
    # Advisory, never RED, and deliberately so: cmd_doctor_notify fires a
    # notification on ANY non-zero exit, and on a second machine (SETUP.md Part
    # 10) most work repos are simply not cloned. Flagging that nightly would
    # train the owner to ignore the one report that is supposed to matter. The
    # point is not "this path is broken" — it is "check a durable identity was
    # recorded beside it", which is the thing that survives losing the machine.
    unresolved = {}
    for top in CANONICAL:
        # Suffix matched case-insensitively, as collect_notes() does — a Foo.MD
        # note is still a note, and should not slip past this scan.
        for note in sorted(p for p in (K / top).rglob("*") if p.suffix.lower() == ".md"):
            for match in LOCAL_PATH_RE.finditer(read_text(note)):
                target = match.group(1)
                if not Path(target).expanduser().exists():
                    unresolved.setdefault(target, set()).add(str(note.relative_to(K)))
    if unresolved:
        print(f"  [-- ] {len(unresolved)} local path(s) referenced in notes do not resolve "
              "here — expected on a second machine; confirm each note also records a "
              "durable identity (repo URL)")
        for target in sorted(unresolved):
            print(f"         {target} — {', '.join(sorted(unresolved[target]))}")

    # Local AND remote. `git branch --no-merged` is local-only, so a consolidation
    # branch that was pushed and then pruned locally — or produced on another
    # machine — carried unmerged captures that no health check could see.
    branch_names = [b.strip().lstrip("* ") for b in
                    git("branch", "--no-merged", default_branch(), "--list", "consolidate/*").splitlines()
                    if b.strip()]
    branch_names += [b.strip() for b in
                     git("branch", "-r", "--no-merged", default_branch(), "--list", "origin/consolidate/*")
                     .splitlines() if b.strip()]
    if branch_names:
        ok = False
        print(f"  [RED] unreviewed consolidation branch(es): "
              f"{', '.join(sorted(set(branch_names)))} — review and merge")

    print()
    lint_code = lint()
    return 0 if (ok and lint_code == 0) else 1


def main() -> int:
    argv = sys.argv[1:]
    # --root is INTERNAL: only `lint --staged` re-invokes itself with it to lint
    # an alternate tree. Honoring it for any command turned a user searching for
    # the literal text "--root" into a silent rebind of the repo root (and, for
    # capture, a write outside the brain). Gate it to the lint subcommand.
    if argv[:1] == ["lint"] and "--root" in argv:
        i = argv.index("--root")
        global ROOT, K, INDEX_DB
        ROOT = Path(argv[i + 1]).resolve()
        K = ROOT / "knowledge"
        INDEX_DB = ROOT / ".cache" / "index.db"
        argv = argv[:i] + argv[i + 2:]
    elif argv[:1] != ["setup"]:
        # Skipped for setup, and only for setup. Setup runs out of a throwaway
        # clone of the template and installs the hooks into the DESTINATION,
        # which phase_create does. Here it would mutate a directory that is
        # about to be deleted, and announce it — "brain: installed git hooks"
        # about a temp clone, in the very first output a new user ever sees.
        ensure_hooks()
    if not argv:
        print(__doc__)
        return 2
    if argv[0] in ("--help", "-h", "help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    # `<command> --help` must never DO the command. `init --help` ignored argv
    # entirely and went ahead and wired the machine — re-pointing a global skill
    # symlink and registering an MCP server — for someone who only asked what it
    # does. Only the leading argument counts, so free-text commands like
    # `capture` can still carry the literal word in their content.
    if rest[:1] in (["--help"], ["-h"]):
        print(__doc__)
        return 0
    if cmd == "lint":
        try:
            return lint(staged_only="--staged" in rest)
        except Exception as exc:  # environment failure must not look like content failure
            print(f"brain lint: environment failure: {exc!r}")
            return 3
    if cmd == "setup":
        # Imported here, not at module scope: setup pulls in the picker and
        # everything the phases need, and it is the one command in this file
        # that most sessions never run.
        from brainlib.setup import run_setup
        return run_setup(rest)
    if cmd == "init":
        return cmd_init(rest)
    if cmd == "connect":
        return cmd_connect(rest)
    if cmd == "serve":
        # Local import for the same reason setup's is: this pulls in the HTTP
        # server machinery, and most sessions never serve anything.
        from brainlib.serve import run_serve
        return run_serve(rest)
    if cmd == "new":
        return cmd_new(rest)
    if cmd == "capture":
        return cmd_capture(rest)
    if cmd == "doctor":
        return cmd_doctor()
    if cmd == "stats":
        return cmd_stats(rest)
    if cmd == "plugin":
        return cmd_plugin(rest)
    if cmd == "doctor-notify":
        return cmd_doctor_notify()
    if cmd == "index":
        return cmd_index(quiet="--quiet" in rest)
    if cmd == "search":
        return cmd_search(rest)
    if cmd == "read":
        return cmd_read(rest)
    if cmd == "links":
        return cmd_links(rest)
    if cmd == "recent":
        return cmd_recent(rest)
    if cmd == "supersede":
        return cmd_supersede(rest)
    if cmd == "sessions":
        return cmd_sessions(rest)
    if cmd == "consolidate":
        return cmd_consolidate(rest)
    if cmd == "schedule":
        return cmd_schedule(rest)
    if cmd == "template":
        return cmd_template(rest)
    if cmd in ("retire", "reset"):
        return cmd_retire(rest, alias=(cmd == "reset"))
    print(f"unknown command {cmd!r}\n{__doc__}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
