# The weekly consolidation pass: drain inbox/, promote what earns a note,
# delete what does not, on a branch that waits for the audit.
#
# Separate from brain-maintenance.service on purpose. Consolidation is the one
# operation in this system whose accuracy depends on a model, it is the only
# scheduled job that holds the repository write lock for minutes at a time, and
# it is the only one that reaches an external provider. Bundling it into the
# nightly unit would mean a provider outage marks index and lint as failed too.
[Unit]
Description=brain weekly consolidation
Documentation=file:///srv/brain/engine/setup/runbooks/remote-brain.md
After=brain-maintenance.service docker.service
Requires=docker.service
OnFailure=brain-alert@%n.service

[Service]
Type=oneshot
# propose_timeout (1800s) + audit_timeout (900s) from setup/consolidator.conf,
# plus room for the container to start. Shorter than the sum would kill a run
# that the config says is still legitimately working.
TimeoutStartSec=60min
EnvironmentFile=-/etc/brain/deploy.env
Environment=BRAIN_COMPOSE=/srv/brain/engine/deploy/compose.yaml
Environment=DOCKER_CONFIG=/tmp/docker
Environment=DOCKER_CLI_HINTS=false

ExecStart=/usr/bin/docker compose --file ${BRAIN_COMPOSE} --project-name brain --profile maintenance run --rm --no-deps brain-maintenance consolidate

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
