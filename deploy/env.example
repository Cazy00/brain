# deploy/env.example — NAMES and safe placeholders. Never a value.
#
# Copy to deploy/.env. Docker Compose reads `.env` from the project directory,
# which is the directory holding the first -f file, so it must be `deploy/.env`
# and not one at the repository root.
#
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env
#
# deploy/.env is machine-local and must be gitignored. It holds no credential
# even so — every variable below is a host path or a version string, and that
# is a rule, not a coincidence. If a value here would matter to an attacker who
# read it, it is in the wrong file: secrets are root-owned files under
# /etc/brain on the VPS, mode 0600, mounted into the containers. The repository
# rule is the older one and still governs — NO credentials, tokens or keys
# anywhere in this repo, and the hooks enforce it.


# --- Required. No default, deliberately. --------------------------------------

# The image tag production runs. Compose fails loudly if it is unset rather
# than falling back to a moving tag: the spec's rule is that production deploys
# a tagged release, and naming the tag is also what leaves the previous
# release's image on disk under its own name for a rollback.
#   e.g. BRAIN_VERSION=v1.0.0
BRAIN_VERSION=

# Host path to the named tunnel's credentials file, mounted read-only into the
# cloudflared container. The FILE is a credential; this variable is only its
# location, which is why the location lives here and the file does not. It must
# be readable by uid 65532, the nonroot uid the pinned distroless cloudflared
# image runs as.
#   e.g. BRAIN_HOST_TUNNEL_CREDENTIALS=/etc/brain/tunnel-credentials.json
BRAIN_HOST_TUNNEL_CREDENTIALS=


# --- Optional. The defaults are the reference deployment. ---------------------

# Host side of the three bind mounts. These are HOST paths and are named
# differently from the container paths on purpose: BRAIN_DATA_ROOT and
# BRAIN_STATE_DIR are the container-side variables from the interface contract,
# they are fixed strings inside compose.yaml, and they are NOT settable here. A
# single name used for both sides is one typo away from a container that mounts
# the wrong tree — and bin/brain will create a knowledge/ skeleton wherever it
# is pointed, so the typo produces an empty brain rather than an error.
#
# Ownership matters as much as the path. A bind mount carries the host's uid,
# gid and mode straight through, and the brain container is uid 10001 with
# every Linux capability dropped:
#
#   /srv/brain/data    chown 10001:10001, the private knowledge git repository
#   /srv/brain/state   chown 10001:10001, index, locks, ledger, sessions
#   /etc/brain         root-owned directory; the files inside it that the
#                      container reads must each be readable by uid 10001
#
BRAIN_HOST_DATA=/srv/brain/data
BRAIN_HOST_STATE=/srv/brain/state
BRAIN_HOST_ETC=/etc/brain


# --- Do NOT set these here ----------------------------------------------------
#
# COMPOSE_PROJECT_NAME
#     compose.yaml declares `name: brain`, but this variable OVERRIDES the
#     declared name. Setting it renames every container, network and volume and
#     leaves the previous project's containers running and orphaned.
#
# BRAIN_DATA_ROOT / BRAIN_STATE_DIR / BRAIN_HTTP_CONFIG
#     Container-side paths, fixed in compose.yaml. Setting them in this file
#     does nothing on its own, but a name that looks settable and is not is how
#     someone later "fixes" a mount by editing the wrong side of it.
#
# Anything at all whose value is secret. For reference, the private material
# the VPS holds, by FILENAME only — none of it is configured here:
#
#   /etc/brain/brain-http.json     the service config: team_domain, owner_email,
#                                  endpoints[{hostname, aud, profile}],
#                                  service_principals{common_name: profile},
#                                  principal_key_file, git_push, log_level.
#                                  Mode 0600, owned by uid 10001.
#   /etc/brain/principal-key       HMAC key deriving the stable principal id in
#                                  the event log, so the log never holds a raw
#                                  email. Mounted at /run/secrets/principal_key;
#                                  that is the path brain-http.json names.
#   /etc/brain/git-deploy-key      SSH key for `git push` to the private data
#                                  remote, scoped to that one repository. Read
#                                  through the /etc/brain mount. ssh(1) refuses
#                                  a key that is group- or world-readable, so
#                                  this one is 0600 owned by uid 10001.
#   the tunnel credentials file    located by BRAIN_HOST_TUNNEL_CREDENTIALS
#                                  above; readable by uid 65532.
#   deploy/cloudflared/config.yml  rendered from config.yml.example with the
#                                  tunnel id filled in. Untracked.
