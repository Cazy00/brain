# .cursorignore — keeps Cursor's own file index out of the parts of this
# brain that are not current knowledge. A BACKSTOP, not the control:
# these files do not stop an agent's terminal or MCP tools from reading
# the same paths. The rule that holds is in AGENTS.md — retrieve through
# bin/brain search or the MCP tools, which resolve currency and print the
# trust signals a raw file read has no way to carry.
#
# Generated by `bin/brain connect --write-ignores`.

knowledge/archive/
knowledge/vault/
knowledge/inbox/
knowledge/journal/
.cache/
